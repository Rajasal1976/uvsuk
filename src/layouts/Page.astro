---
// The frame every page sits in: <head> for SEO, header, footer.
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';

interface Props {
  title: string;
  description: string;
  schemas?: string[];   // extra structured data, e.g. FAQ (JSON text)
  noindex?: boolean;    // hide from Google (draft pages)
}
const { title, description, schemas = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

// "Edit this page" button: only shown to someone logged in to the editor (/admin) in this browser.
const editable = new Set(Object.keys(import.meta.glob('../../content/pages/*.json')).map((p) => p.split('/').pop()!.replace('.json', '')));
const slug = Astro.url.pathname.replace(/^\/|\/$/g, '');
const editUrl = slug === '' ? '/admin/#/collections/homepage/entries/home'
  : editable.has(slug) ? `/admin/#/collections/pages/entries/${slug}`
  : '/admin/';
const editLabel = editUrl === '/admin/' ? 'Open the editor' : 'Edit this page';

const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.legalName,
  url: site.url,
  telephone: site.phoneIntl,
  address: { '@type': 'PostalAddress', streetAddress: site.address.line1, addressLocality: site.address.city, postalCode: site.address.postcode, addressCountry: 'GB' },
  openingHours: site.hoursSchema,
};
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&family=Inter:wght@400;500;600&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify(business)} />
  {schemas.map((s) => <script type="application/ld+json" set:html={s} />)}
  <slot name="head" />
</head>
<body>
  <Header />
  <slot />
  <Footer />
  <a id="edit-page" href={editUrl} rel="nofollow" style="position:fixed;left:16px;bottom:16px;z-index:50;display:none;align-items:center;gap:8px;padding:12px 18px;border-radius:999px;background:#0D3B21;color:#fff;font:600 15px/1 Inter,system-ui,sans-serif;text-decoration:none;box-shadow:0 6px 18px rgba(0,0,0,.25)">
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>{editLabel}
  </a>
  <script is:inline>
    try { if (localStorage.getItem('decap-cms-user')) document.getElementById('edit-page').style.display = 'inline-flex'; } catch (e) {}
  </script>
</body>
</html>
