---
import Page from '../../layouts/Page.astro';
import { posts, fmtDate } from '../../data/blog.js';
---
<Page title="Visa and Immigration News & Guides | UVS Blog" description="News and practical guides on UK immigration and travel visas from IAA-regulated advisers in Manchester: rule changes, deadlines and how to apply.">
  <main>
    <div class="page-head">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a></nav>
        <h1>Blog: visa and immigration news</h1>
        <p class="lead">Rule changes, deadlines and practical guides from our advisers, written for UK residents.</p>
      </div>
    </div>
    <div class="wrap section" style="padding-top:56px">
      <div class="blog-list">
        {posts.map((p) => (
          <article class="blog-card">
            <p class="blog-date"><time datetime={p.date}>{fmtDate(p.date)}</time>{p.category && <> · {p.category}</>}</p>
            <h2><a href={`/blog/${p.slug}/`}>{p.h1}</a></h2>
            <p>{p.intro}</p>
            <a class="blog-more" href={`/blog/${p.slug}/`}>Read more<span class="sr-only">: {p.h1}</span></a>
          </article>
        ))}
      </div>
    </div>
  </main>
</Page>

<style>
  .blog-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 28px; }
  .blog-card { border: 1px solid var(--line); border-radius: 12px; padding: 24px 26px; background: #fff; display: flex; flex-direction: column; gap: 10px; }
  .blog-card h2 { font-size: 22px; margin: 0; line-height: 1.3; }
  .blog-card h2 a { color: var(--green-800); text-decoration: none; }
  .blog-card h2 a:hover { text-decoration: underline; }
  .blog-card p { margin: 0; }
  .blog-date { color: var(--ink-mute); font-size: 14px; }
  .blog-more { margin-top: auto; font-weight: 600; color: var(--green-800); }
</style>
