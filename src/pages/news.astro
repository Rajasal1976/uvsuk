---
// Visa news page: lists blog posts whose category is "News" (content/blog, edited in the admin under "Blog posts").
// To add a news story, create a blog post and set its Category to "News".
import Page from '../layouts/Page.astro';
import { posts, fmtDate } from '../data/blog.js';
const news = posts.filter((p) => p.category === 'News');
---
<Page title="Visa News for UK Travellers | Latest Rule Changes | UVS" description="Latest visa news for UK residents: new entry rules, e-Visa changes, visa-free deals and UK immigration updates, explained by IAA-regulated advisers in Manchester.">
  <main>
    <div class="page-head">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a></nav>
        <h1>Visa news</h1>
        <p class="lead">The latest visa and immigration news for UK residents, checked against official sources and explained in plain English: new entry rules abroad, e-Visa changes, visa-free deals and changes to UK immigration rules.</p>
      </div>
    </div>
    <div class="wrap section" style="padding-top:56px">
      {news.length ? (
        <div class="blog-list">
          {news.map((p) => (
            <article class="blog-card">
              <p class="blog-date"><time datetime={p.date}>{fmtDate(p.date)}</time></p>
              <h2><a href={`/blog/${p.slug}/`}>{p.h1}</a></h2>
              <p>{p.intro}</p>
              <a class="blog-more" href={`/blog/${p.slug}/`}>Read more<span class="sr-only">: {p.h1}</span></a>
            </article>
          ))}
        </div>
      ) : <p>No news stories yet. See our <a href="/blog/">blog</a> for guides.</p>}
      <p class="news-foot">Planning a trip or an application? Our <a href="/blog/">guides</a> and <a href="/uk-immigration-tools/">free tools</a> can help, or <a href="/contact-us/">talk to an adviser</a>.</p>
    </div>
  </main>
</Page>

<style>
  .blog-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 28px; }
  .blog-card { border: 1px solid var(--line); border-radius: 12px; padding: 24px 26px; background: #fff; display: flex; flex-direction: column; gap: 10px; }
  .blog-card h2 { font-size: 22px; margin: 0; line-height: 1.3; }
  .blog-card h2 a { color: var(--green-800); text-decoration: none; }
  .blog-card h2 a:hover { text-decoration: underline; }
  .blog-card p { margin: 0; }
  .blog-date { color: var(--ink-mute); font-size: 14px; }
  .blog-more { margin-top: auto; font-weight: 600; color: var(--green-800); }
  .news-foot { margin-top: 40px; color: var(--ink-mute); }
</style>
