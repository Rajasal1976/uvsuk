---
// One page per online application form: /apply/china-visa/, /apply/india-visa/, /apply/sri-lanka-eta/
import Page from '../../layouts/Page.astro';
import { applications, declaration } from '../../data/applications.js';
import { site } from '../../data/site.js';
import '../../styles/apply.css';

import { customStep } from '../../lib/custom-questions.js';

export function getStaticPaths() {
  // Form settings from the admin ("Form settings"): extra questions, and documents or questions
  // to remove or make optional. Essential details can't be removed.
  const extras = Object.values(import.meta.glob('../../../content/form-extras/*.json', { eager: true, import: 'default' }));
  const norm = (t) => String(t || '').toLowerCase().replace(/\s+/g, ' ').trim();
  const list = (x) => (Array.isArray(x) ? x : []).map((v) => norm(typeof v === 'string' ? v : v?.text)).filter(Boolean);
  const hits = (label, words) => words.some((w) => norm(label).includes(w));
  const PROTECTED = new Set(['surname', 'givenNames', 'dateOfBirth', 'sex', 'nationality', 'passportNumber', 'passportExpiry', 'passportIssuingCountry', 'email', 'phone', 'visaType', 'destination']);
  return applications.map((a) => {
    const extra: any = extras.find((x: any) => x.form === a.slug) || {};
    const hideDocs = list(extra.hideDocs), optDocs = list(extra.optionalDocs);
    const hideQs = list(extra.hideQuestions), optQs = list(extra.optionalQuestions);
    const uploads = (a.uploads || [])
      .filter((u) => !hits(u.label, hideDocs))
      .map((u) => (hits(u.label, optDocs) ? { ...u, required: false } : u));
    const steps = a.steps
      .map((st) => ({
        ...st,
        fields: st.fields
          .filter((f) => PROTECTED.has(f.name) || !hits(f.label, hideQs))
          .map((f) => (!PROTECTED.has(f.name) && hits(f.label, optQs) ? { ...f, required: false } : f)),
      }))
      .filter((st) => st.fields.length || st.passportScan);
    const step = customStep(extra, 'custom');
    return { params: { form: a.slug }, props: { app: { ...a, uploads, steps: step ? [...steps, step] : steps } } };
  });
}
const { app } = Astro.props;
const opts = { declaration, phone: site.phone, phoneIntl: site.phoneIntl };
---
<Page title={`${app.title} | Apply online | Unique Visa Services`} description={app.description}>
  <main>
    <div class="page-head ap-pagehead">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/apply/">Apply online</a> / <a href={app.pageUrl}>{app.country}</a></nav>
        <h1>{app.title}</h1>
        <p class="lead">{app.description}</p>
        <ul class="ap-facts">
          <li>About {app.minutes} minutes</li>
          <li>Passport details filled in for you</li>
          <li>Checked by an IAA-regulated adviser</li>
        </ul>
      </div>
    </div>
    <div class="wrap section ap-section">
      {app.notice && <p class="ap-notice">{app.notice}</p>}
      <div id="application" data-config={JSON.stringify(app)} data-opts={JSON.stringify(opts)}>
        <noscript><p>This form needs JavaScript. Please turn it on, or call us on {site.phone} and we'll help you apply.</p></noscript>
      </div>
    </div>
  </main>
</Page>

<script>
  import { mountApplication } from '../../lib/apply-form.js';
  const root = document.getElementById('application')!;
  mountApplication(root, JSON.parse(root.dataset.config!), JSON.parse(root.dataset.opts!));
</script>
