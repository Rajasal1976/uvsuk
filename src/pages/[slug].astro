---
// Every page in src/data/pages.js is built from this one template.
// Edit page text in src/data/pages.js, not here.
// Pages with their own file in src/pages (the ones with calculators or extra design)
// are listed in `own` below so they aren't built twice.
import Page from '../layouts/Page.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import ApplyButton from '../components/ApplyButton.astro';
import HeadFlag from '../components/HeadFlag.astro';
import VisaBar from '../components/VisaBar.astro';
import { flagFor } from '../data/flags.js';
import { visaFinder } from '../data/finder.js';
import PriceTables from '../components/PriceTables.astro';
import PriceCalculator from '../components/PriceCalculator.astro';
import GuideSections from '../components/GuideSections.astro';
import DocumentsTable from '../components/DocumentsTable.astro';
import OfficePanel from '../components/OfficePanel.astro';
import { pages, pageBySlug } from '../data/pages.js';
import { site } from '../data/site.js';

export function getStaticPaths() {
  const own = ['indefinite-leave-to-remain-ilr', 'skilled-worker-visa-formally-tier-t2-general', 'china-visa-application'];
  return pages.filter((p) => !own.includes(p.slug)).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const hubFor = { uk: ['UK Visas', '/uk-visa-services/'], employer: ['Employers', '/hire-foreign-nationals-uk/'], worldwide: ['Worldwide Visas', '/worldwide-visas/'] };
const hub = hubFor[p.group];
const showCrumb = hub && hub[1] !== `/${p.slug}/`;
// Visa bar and flag under the banner on every visa page (not company pages such as About us)
const withBar = p.group !== 'company';
const hasFlag = withBar && !!flagFor(p.country);
// Country step in the breadcrumb (Home / Worldwide visas / China), linking to the country's main page
const countryRow = p.group === 'worldwide' ? visaFinder.find((r) => r[0] === p.country) : null;
const countryCrumb = countryRow && countryRow[1] !== `/${p.slug}/` ? [p.country, countryRow[1]] : null;
const howWeHelp = [
  'Check your eligibility and confirm the right route at your consultation',
  'Give you a personalised document checklist',
  'Prepare and complete your application forms',
  'Review all evidence against the current rules before submission',
  'Keep you updated until you have a decision',
];
---
<Page title={p.title} description={p.description}>
  <main>
    <div class="head-zone">
    <div class:list={['page-head', { 'has-bar': withBar, 'has-flag': hasFlag }]}>
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a>{showCrumb && <> / <a href={hub[1]}>{hub[0]}</a></>}{countryCrumb && <> / <a href={countryCrumb[1]}>{countryCrumb[0]}</a></>}</nav>
        <h1>{p.h1}</h1>
        {p.intro && <p class="lead">{p.intro}</p>}
        {!withBar && <ApplyButton url={p.applyButton} />}
        {hasFlag && <HeadFlag country={p.country} applyUrl={p.applyButton} />}
      </div>
    </div>
    {withBar && <VisaBar slug={p.slug} country={p.country} applyUrl={p.applyButton} applyInHead={hasFlag} />}
    </div>

    <div class="wrap section page-body" style="padding-top:64px">
      <div class="content">
        {p.type === 'hub' && (
          <div class="grid">
            {p.children.map((c) => {
              const child = pageBySlug[c];
              return (
                <a href={`/${c}/`} class="card">
                  <h3>{child.h1}</h3>
                  <p>{child.description}</p>
                  <span class="more">Find out more</span>
                </a>
              );
            })}
          </div>
        )}

        {p.type === 'service' && (
          <>
            <div id="requirements"></div>
            {p.eligibility?.length > 0 && (
              <section><h2>Do you qualify?</h2><ul>{p.eligibility.map((e) => <li>{e}</li>)}</ul></section>
            )}
            <DocumentsTable rows={p.documentsTable} applyUrl={p.applyButton} />
            <GuideSections sections={p.sections} />
            <section><h2>How we help</h2><ul>{howWeHelp.map((h) => <li>{h}</li>)}</ul></section>
            {p.visa && p.group === 'worldwide' ? <><PriceTables prices={p.prices} kind={p.visa} applyUrl={p.applyButton} />{p.calculator && <PriceCalculator calc={p.calculator} prices={p.prices} applyUrl={p.applyButton} />}</> : (
              <section>
                <h2>Fees and timescales</h2>
                <p>Our fee is agreed before we start. <a href="/fees/">See our fees</a>. Government fees are paid separately{p.govuk && <>, and are listed on <a href={p.govuk}>GOV.UK</a></>}.</p>
              </section>
            )}
          </>
        )}

        {p.type === 'info' && p.body?.length > 0 && <div class="prose">{p.body.map((t) => <p>{t}</p>)}</div>}

        {p.type !== 'service' && <GuideSections sections={p.sections} />}
        {p.type === 'hub' && p.govuk && <p class="soft">Official rules and fees: <a href={p.govuk}>GOV.UK</a></p>}

        <Faq items={p.faqs} />

        {p.related?.length > 0 && (
          <section>
            <h2>Related services</h2>
            <ul>{p.related.map((r) => <li><a href={`/${r}/`}>{pageBySlug[r].h1}</a></li>)}</ul>
          </section>
        )}
      </div>
      {p.group !== 'company' && (
        <aside class="aside">
          <div class="panel">
            <h2>Talk to an adviser</h2>
            <p class="soft" style="font-size:16px">Book a consultation and we'll confirm your options, what you'll need and our fee.</p>
            <a href={site.bookingUrl} class="btn btn-primary">Book a consultation</a>
            <a href={`tel:${site.phoneIntl}`} class="btn btn-outline">Call {site.phone}</a>
            <p style="font-size:14px;color:var(--ink-mute)">IAA-regulated · Ref {site.iaaRef}</p>
          </div>
          {['uk', 'employer', 'local'].includes(p.group) && <OfficePanel />}
        </aside>
      )}
    </div>

    <CtaBand />
  </main>
</Page>
