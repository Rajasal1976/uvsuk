---
// Homepage. Text is edited in the admin under Homepage (content/home.json).
// The visa tiles come from the e-Visa pages themselves, so a new e-Visa page appears here automatically.
import Page from '../layouts/Page.astro';
import Flow from '../components/Flow.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Eligibility from '../components/Eligibility.astro';
import home from '../../content/home.json';
import { site } from '../data/site.js';
import { pagesIn, navName } from '../data/pages.js';
import { svg } from '../data/icons.js';

const tiles = pagesIn('evisa').map((p) => ({
  slug: p.slug, name: navName(p), title: p.h1, meta: p.facts?.[0] ? `${p.facts[0].value}: ${p.facts[0].label}` : '',
  text: p.cardText || p.description, docs: (p.checklist || []).map((c) => c.item), apply: p.applyButton && p.applyButton !== 'none' ? p.applyButton : site.applyUrl,
  feature: p.highlight === true,
}));
const options = home.heroOptions || [];
const ourFee = site.serviceFee || 'Call for a quote';
---
<Page title={home.title} description={home.description} crumbs={[]}>
  <main>
    <section class="teal">
      <div class="wrap hero-grid">
        <div>
          {home.heroEyebrow && <span class="eyebrow">{home.heroEyebrow}</span>}
          <h1>{home.heroHeading}{home.heroAccent && <span>{home.heroAccent}</span>}</h1>
          <p class="lead">{home.heroIntro}</p>
          <div class="btn-row">
            <a class="btn btn-gold" href={site.applyUrl}>Start my application</a>
            <a class="btn btn-ghost-light" href={`tel:${site.phoneIntl}`}>Call {site.phone}</a>
          </div>
          <ol class="mini-steps" aria-label="The four steps">
            {(home.steps || []).slice(0, 4).map((s, i, a) => <><li><b>{i + 1}</b>{s.short || s.title}</li>{i < a.length - 1 && <li class="sep" aria-hidden="true">›</li>}</>)}
          </ol>
        </div>
        <div class="card-float" id="eligibility">
          <h2>Can you get an e-Visa?</h2>
          <p>Most nationalities can apply online. Type yours to check.</p>
          <Eligibility id="nat" />
          <fieldset class="types">
            <legend>Reason for your trip</legend>
            {options.map((o, i) => <label class="type"><input type="radio" name="vtype" value={i} checked={i === 0} /><span>{o.label}<em>{o.sub}</em></span></label>)}
          </fieldset>
          <div class="type-note" id="type-note" aria-live="polite" set:html={`<strong>${options[0]?.label} ${options[0]?.sub}:</strong> ${options[0]?.note}`} />
          <a class="btn btn-gold" id="picker-go" href={options[0]?.link || site.applyUrl}>{options[0]?.button || 'Start my application'}</a>
          <small>Your answers are saved as you go, so you can finish later.</small>
          <script type="application/json" id="hero-options" set:html={JSON.stringify(options)} />
        </div>
      </div>
    </section>

    <Flow />

    <section class="section" id="visas">
      <div class="wrap">
        <div class="section-head"><h2>{home.tilesTitle}</h2><p>{home.tilesIntro}</p></div>
        <div class="vtiles">
          {tiles.map((t) => <a class={t.feature ? 'vtile feature' : 'vtile'} href={`/${t.slug}/`}>{t.name}<span set:html={svg('arrow', 18)} /></a>)}
        </div>
        <div class="note-box"><span set:html={svg('info')} /><p><strong>Can’t use an e-Visa?</strong> Work, journalism, longer stays, Pakistani origin or a military background need a regular visa. <a href="/indian-regular-visa/">Regular Indian visas</a> or <a href={`tel:${site.phoneIntl}`}>call {site.phone}</a>.</p></div>
      </div>
    </section>

    <section class="section tinted" id="check">
      <div class="wrap">
        <div class="section-head"><h2>{home.checksTitle}</h2><p>{home.checksIntro}</p></div>
        <div class="checks">
          {(home.checks || []).map((c) => <article class="check"><div class="icon-box" set:html={svg(c.icon)} /><h3>{c.title}</h3><p>{c.text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="section" id="fees">
      <div class="wrap">
        <div class="section-head"><h2>Two fees, shown separately</h2><p>You always see what goes to the Indian government and what you pay us.</p></div>
        <div class="fees">
          <div class="fee"><span class="fee-label">Government e-Visa fee</span><div class="amount">Set by India</div><p>Depends on your nationality and visa. Paid to the Government of India and not refundable, even if the visa is refused. Card payments carry a small bank charge.</p></div>
          <div class="fee ours"><span class="fee-label">Our service fee</span><div class="amount">{ourFee}</div><p>Per person, for checking your eligibility, fixing your photo and scans, and submitting your application.</p></div>
        </div>
        <div class="note-box"><span set:html={svg('info')} /><p><strong>No “express” fees.</strong> The Indian government doesn’t sell faster e-Visas, so we don’t either. Our job is getting your application right first time.</p></div>
      </div>
    </section>

    {home.sections?.length > 0 && (
      <section class="section tinted">
        <div class="wrap content">
          {home.sections.map((s) => <section><h2>{s.heading}</h2>{s.text.split(/\n\s*\n/).map((t) => <p>{t}</p>)}</section>)}
        </div>
      </section>
    )}

    <section class="section"><div class="wrap"><Faq items={home.faqs} title="Questions people ask" /></div></section>
    <CtaBand />
  </main>
</Page>
<script>
  // Visa options in the banner card
  const opts = JSON.parse(document.getElementById('hero-options')?.textContent || '[]');
  const note = document.getElementById('type-note');
  const go = document.getElementById('picker-go') as HTMLAnchorElement | null;
  document.querySelectorAll<HTMLInputElement>('input[name="vtype"]').forEach((r) => r.addEventListener('change', () => {
    const o = opts[Number(r.value)];
    if (!o || !note || !go) return;
    note.innerHTML = `<strong>${o.label} ${o.sub}:</strong> ${o.note}`;
    go.textContent = o.button; go.href = o.link;
  }));
</script>
