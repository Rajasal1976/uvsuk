<script>
  // Visa finder: choose a country, then the visa type, then go to that page
  const box = document.querySelector<HTMLElement>('.visa-finder');
  if (box) {
    const data: [string, string, [string, string][], string?][] = JSON.parse(box.dataset.finder || '[]');
    const country = box.querySelector<HTMLSelectElement>('#visa-country')!;
    const type = box.querySelector<HTMLSelectElement>('#visa-type')!;
    country.addEventListener('change', () => {
      const row = data.find((r) => r[0] === country.value);
      type.innerHTML = '';
      if (!row) {
        type.disabled = true;
        type.add(new Option(country.value === '__other' ? 'See all countries' : 'Select a country first', ''));
        return;
      }
      type.disabled = false;
      type.add(new Option(row[2].length ? `All ${row[0].replace(/ visas$/, '')} visa options` : (row[3] || `${row[0]} visa`), row[1]));
      for (const [label, url] of row[2]) type.add(new Option(label, url));
    });
    // Type-to-search country box: filters the list as you type, then sets the country above
    const input = box.querySelector<HTMLInputElement>('#visa-country-input')!;
    const list = box.querySelector<HTMLUListElement>('#country-list')!;
    const toggle = box.querySelector<HTMLButtonElement>('.combo-toggle')!;
    const names = data.map((r) => r[0]);
    const aliases: Record<string, string> = { uk: 'UK visas', 'united kingdom': 'UK visas', britain: 'UK visas', 'great britain': 'UK visas', england: 'UK visas', usa: 'USA', us: 'USA', america: 'USA', 'united states': 'USA', uae: 'UAE', dubai: 'UAE', 'abu dhabi': 'UAE', 'united arab emirates': 'UAE', europe: 'Schengen', schengen: 'Schengen', holland: 'Netherlands', ksa: 'Saudi Arabia', saudi: 'Saudi Arabia', 'south korea': 'Korea', 'hong kong': 'China' };
    const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
    let active = -1;
    let matches: string[] = [];
    const choose = (name: string) => {
      country.value = name;
      input.value = name === '__other' ? 'Other countries' : name;
      close();
      country.dispatchEvent(new Event('change'));
    };
    const close = () => { list.hidden = true; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); active = -1; };
    const render = (q: string) => {
      const n = norm(q);
      const alias = Object.entries(aliases).filter(([k]) => n && k.startsWith(n)).map(([, v]) => names.find((x) => norm(x).startsWith(norm(v)))).filter(Boolean) as string[];
      const starts = names.filter((x) => norm(x).startsWith(n));
      const contains = names.filter((x) => !starts.includes(x) && norm(x).includes(n));
      matches = n ? [...new Set([...alias, ...starts, ...contains])] : names;
      list.innerHTML = '';
      matches.forEach((name, i) => {
        const li = document.createElement('li');
        li.id = `country-opt-${i}`; li.setAttribute('role', 'option'); li.textContent = name;
        li.addEventListener('mousedown', (e) => { e.preventDefault(); choose(name); });
        list.append(li);
      });
      const other = document.createElement('li');
      other.className = 'combo-other'; other.setAttribute('role', 'option'); other.id = 'country-opt-other';
      other.textContent = matches.length ? 'Other countries' : 'No match. See all countries';
      other.addEventListener('mousedown', (e) => { e.preventDefault(); choose('__other'); });
      list.append(other);
      active = n && matches.length ? 0 : -1;
      highlight();
      list.hidden = false; input.setAttribute('aria-expanded', 'true');
    };
    const highlight = () => {
      [...list.children].forEach((li, i) => li.classList.toggle('on', i === active));
      const li = list.children[active] as HTMLElement | undefined;
      if (li) { input.setAttribute('aria-activedescendant', li.id); li.scrollIntoView({ block: 'nearest' }); }
    };
    input.addEventListener('focus', () => {
      input.select();
      render('');
      if (window.matchMedia('(max-width: 700px)').matches) setTimeout(() => input.scrollIntoView({ behavior: 'smooth', block: 'start' }), 250);
    });
    input.addEventListener('input', () => render(input.value));
    input.addEventListener('keydown', (e) => {
      const count = list.children.length;
      if (e.key === 'ArrowDown') { e.preventDefault(); if (list.hidden) render(input.value); active = Math.min(active + 1, count - 1); highlight(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(active - 1, 0); highlight(); }
      else if (e.key === 'Enter') { e.preventDefault(); const li = list.children[active] as HTMLElement | undefined; if (li) choose(li.classList.contains('combo-other') ? '__other' : li.textContent!); else if (matches[0]) choose(matches[0]); }
      else if (e.key === 'Escape') { close(); input.value = country.value === '__other' ? 'Other countries' : country.value; }
    });
    input.addEventListener('blur', () => {
      if (list.hidden) return;
      const exact = names.find((x) => norm(x) === norm(input.value));
      if (exact && exact !== country.value) choose(exact);
      else { close(); input.value = country.value === '__other' ? 'Other countries' : country.value; }
    });
    toggle.addEventListener('mousedown', (e) => { e.preventDefault(); if (list.hidden) { input.focus(); } else close(); });

    // UK visas is selected when the page loads, so fill in its visa types straight away
    if (country.value) country.dispatchEvent(new Event('change'));
    box.querySelector('#visa-check')!.addEventListener('click', () => {
      if (country.value === '__other') return void (window.location.href = '/worldwide-visas/');
      const url = type.value || data.find((r) => r[0] === country.value)?.[1];
      if (url) window.location.href = url;
      else input.focus();
    });
  }
</script>

