---
// Homepage. Most of the text here is edited in the admin (content/home.json and settings.json).
import Page from '../layouts/Page.astro';
import GuideSections from '../components/GuideSections.astro';
import home from '../../content/home.json';
import { site } from '../data/site.js';
const title = home.title;
const description = home.description;
const schemas = [JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: home.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
})];
const tel = `tel:${site.phoneIntl}`;
// "Get directions" opens Google Maps at the office address
const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.address.line1}, ${site.address.city} ${site.address.postcode}`)}`;
// Service tiles in the "Visit us" card. The last one (document legalisation) is highlighted in gold.
const serviceTiles = [
  ['UK immigration', 'Spouse, work, ILR and citizenship', '/uk-visa-services/', false],
  ['Worldwide visas', 'Visas and eVisas for travel', '/worldwide-visas/', false],
  ['Document legalisation', 'Apostilles and attestation', '/document-legalisation/', true],
];
// "Popular" buttons beside the visa search (edited in the admin: Homepage › Popular links)
const popularLinks = (home.popularLinks?.length ? home.popularLinks.map((x) => [x.label, x.url]) : [
  ['UK Immigration', '/uk-visa-services/'], ['2nd Passport', '/second-uk-passport/'], ['Schengen Visa', '/schengen-visa-application/'], ['China Visa', '/china-visa-application/'],
  ['India Visa', '/indian-visa-application-uk/'], ['Ghana Visa', '/ghana-visa-services/'], ['USA Visa', '/usa-visa-services/'], ['Japan Visa', '/japan-visa-services/'],
]).slice(0, 8);
// Industry links in the "For employers" section, taken from the Sponsor licence by industry page
import { pageBySlug as pagesBySlug } from '../data/pages.js';
const industryLinks = (pagesBySlug['sponsor-licence-by-industry']?.children ?? []).map((slug) => {
  const pg = pagesBySlug[slug];
  return [(pg?.h1 || slug).replace(/^Sponsor licence for /i, '').replace(/^\w/, (c) => c.toUpperCase()), `/${slug}/`];
});
// "Check your visa requirements": choose a country, then the visa type. Built automatically from
// the pages on the site, so new country or visa-type pages appear here without any changes.
import { pages as allPages } from '../data/pages.js';
const notCountries = new Set(['UK', 'Document legalisation', 'Worldwide visas overview', 'Employers', 'Company pages']);
const shortLabel = (pg, country) => pg.purposeLabel || (pg.h1 || '').replace(/ from the UK.*$/i, '').replace(new RegExp('^' + country + '\\s+', 'i'), '').replace(/^(?!e-)\w/, (c) => c.toUpperCase());
const byCountry = {};
for (const pg of allPages) {
  if (pg.group !== 'worldwide' || !pg.country || notCountries.has(pg.country) || pg.hideFromMenus) continue;
  (byCountry[pg.country] ??= []).push(pg);
}
// A country whose main page is removed from menus is left out of the finder altogether
const offMenuCountries = new Set(allPages.filter((pg) => pg.type === 'hub' && pg.hideFromMenus).map((pg) => pg.country));
const visaFinder = Object.entries(byCountry).filter(([country]) => !offMenuCountries.has(country)).map(([country, list]) => {
  const hub = list.find((x) => x.type === 'hub');
  const main = hub || list[0];
  // Use the order set on the country's main page, then any other pages for that country
  const ordered = hub ? [...(hub.children || []).map((c) => list.find((x) => x.slug === c)).filter(Boolean), ...list.filter((x) => x !== hub && !(hub.children || []).includes(x.slug))] : list.filter((x) => x !== main);
  const types = ordered.map((x) => [shortLabel(x, country), `/${x.slug}/`]);
  // China: every visa type. Those without their own page open the China page with that type selected.
  if (country === 'China') {
    return [country, `/${main.slug}/`, [
      ['Business visa (M)', '/china-business-visa/'],
      ['Tourist visa (L)', '/china-tourist-visa/'],
      ['Family visit visa (Q / S)', '/china-visa-application/#vc-family'],
      ['Work visa (Z)', '/china-work-visa-for-uk-citizens/'],
      ['Student visa (X)', '/china-visa-application/#vc-study'],
      ['Transit visa (G)', '/china-visa-application/#vc-transit'],
      ['Crew visa (C)', '/china-visa-application/#vc-crew'],
      ['Journalist visa (J)', '/china-visa-application/#vc-journalist'],
    ]];
  }
  return [country, `/${main.slug}/`, types, (main.h1 || '').replace(/ from the UK.*$/i, '')];
}).sort((a, b) => a[0].localeCompare(b[0]));
const ukTypes = allPages.filter((x) => x.group === 'uk' && x.type === 'service').map((x) => [x.h1.replace(/^UK /, '').replace(/^\w/, (c) => c.toUpperCase()), `/${x.slug}/`]);
visaFinder.unshift(['UK visas', '/uk-visa-services/', ukTypes]);
// Icons for the three selling points in the banner (edited in the admin: Homepage › Selling points)
const pointIcons = [
  '<svg viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M8.5 12l2.5 2.5 4.5-5"/></svg>',
  '<svg viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M15.5 6.5A3.5 3.5 0 0 0 9 8.3c0 3.2 1.4 4.6.4 8.7h7.1M7 12.5h6"/></svg>',
  '<svg viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M13 2.5L4.5 13.5H11l-1 8 8.5-11H12z"/></svg>',
];
const starIcon = '<svg viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/></svg>';
const photo = 'width: 100%; border-radius: 12px; object-fit: cover; display: block';
const placeholder = 'background: #D6E3DA; border-radius: 12px; display: flex; align-items: center; justify-content: center; text-align: center; color: #3A4552; font-size: 15px; padding: 24px; box-sizing: border-box';
---
<Page title={title} description={description} schemas={schemas}>
<main id="main">
<!-- Hero: visa search first, beside the main heading -->
<section class="home-hero">
<div class="hero-inner">
<div class="hero-text">
<p class="hero-eyebrow">{home.heroEyebrow}</p>
<h1>{home.heroHeading}</h1>
<p class="hero-intro">{home.heroIntro}</p>
<div class="hero-actions">
<a href={site.bookingUrl} class="hero-book">Book a consultation</a>
<a href={tel} class="hero-call">or call {site.phone}</a>
</div>
</div>
<div class="finder-card">
<h2>Visa search</h2>
<p>Choose the country, then the type of visa. For the UK, choose UK visas.</p>
<div class="visa-finder" data-finder={JSON.stringify(visaFinder)}>
<label for="visa-country-input">1. Country</label>
<div class="country-combo">
<input id="visa-country-input" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="country-list" autocomplete="off" autocapitalize="words" spellcheck="false" placeholder="Type a country, e.g. India" value={visaFinder[0]?.[0] ?? ''} />
<button type="button" class="combo-toggle" tabindex="-1" aria-label="Show all countries"></button>
<ul id="country-list" role="listbox" aria-label="Countries" hidden></ul>
</div>
<select id="visa-country" class="sr-only" tabindex="-1" aria-hidden="true">
<option value="">Select a country…</option>
{visaFinder.map(([country], i) => <option value={country} selected={i === 0}>{country}</option>)}
<option value="__other">Other countries</option>
</select>
<label for="visa-type">2. Type of visa</label>
<select id="visa-type" disabled>
<option value="">Select a country first</option>
</select>
<button id="visa-check" type="button">Check requirements</button>
</div>
</div>
</div>
<nav class="hero-popular" aria-label="Popular visas">
<span>Popular visas</span>
{popularLinks.map(([label, href]) => <a href={href}>{label}</a>)}
</nav>
</section>

<!-- Why choose us: selling points and ratings -->
<section class="trust-strip">
<ul>
{(home.heroPoints ?? []).slice(0, 3).map((pt, i) => (
<li>
<span class="trust-icon" aria-hidden="true" set:html={pointIcons[i % pointIcons.length]} />
<span><strong>{pt.title}</strong><span>{pt.text}</span></span>
</li>
))}
<li>
<span class="trust-icon" aria-hidden="true" set:html={starIcon} />
<span><strong>{site.googleRating} ★ rating</strong><span>On Google, Trustpilot and Trustindex. {site.yearsInPractice} years in practice, {site.applicationsHandled} applications handled.</span></span>
</li>
</ul>
</section>

<!-- Visit our office: photo with contact details and the three service areas -->
<section class="office">
<div class="office-inner">
{home.heroPhoto
  ? <img src={home.heroPhoto} alt={home.heroPhotoAlt} width="1200" height="880" loading="lazy" class="office-photo" />
  : <div class="office-photo office-placeholder">Add a photo in the admin: Homepage › Main photo</div>}
<div class="office-card">
<h2>Visit us in Manchester</h2>
<p class="office-lead">Meet an adviser at our city-centre office, or contact us by phone or email.</p>
<p class="office-areas">We help clients across Greater Manchester and beyond, including Leeds, Liverpool, Warrington, Birmingham, Nottingham and Leicester, and anywhere in the UK by phone or video call. <a href="/immigration-advice-manchester/">Our Manchester office</a> · <a href="/areas-we-serve/">Areas we serve →</a></p>
<div class="office-grid">
<p class="fr-item"><span class="fr-label">Office</span>{site.address.line1}<br />{site.address.city} {site.address.postcode}<br /><a class="office-directions" href={directionsUrl} target="_blank" rel="noopener"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>Get directions</a></p>
<p class="fr-item"><span class="fr-label">Opening hours</span>{site.hours}</p>
<p class="fr-item"><span class="fr-label">Telephone</span><a href={`tel:${site.phoneIntl}`}>{site.phoneLabel && `${site.phoneLabel}: `}{site.phone}</a>{site.phone2 && <><br /><a href={`tel:${site.phone2Intl}`}>{site.phone2Label && `${site.phone2Label}: `}{site.phone2}</a></>}</p>
<p class="fr-item"><span class="fr-label">Email</span><a href={`mailto:${site.email}`}>{site.email}</a></p>
</div>
<div class="office-services">
<h3>How we can help</h3>
<ul>
{serviceTiles.map(([title, text, href, featured]) => (
<li><a href={href} class={featured ? 'service-tile service-tile-featured' : 'service-tile'}><strong>{title}<span aria-hidden="true">→</span></strong><span>{text}</span></a></li>
))}
</ul>
</div>
</div>
</div>
</section>

<!-- UK routes -->
<section id="routes" style="max-width: 1200px; margin: 0 auto; padding: 88px 24px; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-direction: column; gap: 12px; max-width: 720px">
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; line-height: 1.15; font-weight: 600; color: #14532D">UK visa and immigration services</h2>
<p style="margin: 0; color: #3A4552">Whichever route applies to you, a regulated adviser reviews your application against current Home Office rules before it's submitted.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px">
<a href="/uk-spouse-visas/" style="text-decoration: none; color: inherit; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 21px; color: #14532D">Spouse &amp; Partner Visas</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Spouse, fiancé and unmarried partner visas, plus extensions. We check your financial requirement and relationship evidence.</p>
<span style="font-weight: 600; color: #14532D; font-size: 15px">View requirements →</span>
</a>
<a href="/skilled-worker-visa-formally-tier-t2-general/" style="text-decoration: none; color: inherit; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 21px; color: #14532D">Skilled Worker Visa</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">New applications, extensions and change of employment, including Certificate of Sponsorship and salary checks.</p>
<span style="font-weight: 600; color: #14532D; font-size: 15px">View requirements →</span>
</a>
<a href="/indefinite-leave-to-remain-ilr/" style="text-decoration: none; color: inherit; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 21px; color: #14532D">Indefinite Leave to Remain</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Settlement applications once you've met the qualifying period, with residence and Life in the UK checks.</p>
<span style="font-weight: 600; color: #14532D; font-size: 15px">View requirements →</span>
</a>
<a href="/british-citizenship/" style="text-decoration: none; color: inherit; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 21px; color: #14532D">British Citizenship</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Naturalisation and registration applications, including residence and good character requirements.</p>
<span style="font-weight: 600; color: #14532D; font-size: 15px">View requirements →</span>
</a>
<a href="/student-visa-uk/" style="text-decoration: none; color: inherit; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 21px; color: #14532D">UK Student Visa</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Student and child student visas and extensions, with CAS and financial evidence checks, plus the Graduate visa.</p>
<span style="font-weight: 600; color: #14532D; font-size: 15px">View requirements →</span>
</a>
<a href="/uk-visit-visa/" style="text-decoration: none; color: inherit; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 21px; color: #14532D">UK Visitor Visa</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Inviting family or business contacts to the UK? We prepare invitation letters, sponsor documents and evidence.</p>
<span style="font-weight: 600; color: #14532D; font-size: 15px">View requirements →</span>
</a>
</div>
</section>

<!-- Employers -->
<section id="employers" style="background: #14532D; color: #E7F2EA">
<div style="max-width: 1200px; margin: 0 auto; padding: 72px 24px; display: flex; flex-wrap: wrap; gap: 32px 56px; align-items: center; justify-content: space-between">
<div style="flex: 1 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 14px">
<p style="margin: 0; font-size: 14px; font-weight: 600; letter-spacing: 0.08em; color: #F2C46D">FOR EMPLOYERS</p>
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 36px; line-height: 1.2; font-weight: 600; color: #FFFFFF">Need to hire from overseas? We'll get your sponsor licence in place.</h2>
<p style="margin: 0; color: #C6DECD">Sponsor licence applications and renewals, Key Personnel set-up, compliance processes and assigning Certificates of Sponsorship, for IT, engineering, hospitality and other UK businesses.</p>
<p style="margin: 6px 0 0; font-size: 14px; font-weight: 600; color: #F2C46D">Sponsor licence guides by industry</p>
<div class="industry-links">
{industryLinks.map(([label, href]) => <a href={href}>{label}</a>)}
<a href="/sponsor-licence-by-industry/">All industries</a>
<a href="/sponsor-licence-compliance/">Compliance support</a>
</div>
</div>
<a href="#book" style="background: #F2C46D; color: #14532D; text-decoration: none; padding: 16px 28px; border-radius: 6px; font-weight: 600">Talk to us about sponsorship</a>
</div>
</section>

<!-- Process -->
<section style="max-width: 1200px; margin: 0 auto; padding: 88px 24px; display: flex; flex-direction: column; gap: 40px">
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; line-height: 1.15; font-weight: 600; color: #14532D">How it works</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px">
<div style="display: flex; flex-direction: column; gap: 10px">
<span style="font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; color: #8A5A12; line-height: 1">1</span>
<h3 style="margin: 0; font-size: 20px; color: #14532D">Consultation</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Tell us your plans and circumstances. We confirm the right route and what it will cost.</p>
</div>
<div style="display: flex; flex-direction: column; gap: 10px">
<span style="font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; color: #8A5A12; line-height: 1">2</span>
<h3 style="margin: 0; font-size: 20px; color: #14532D">Preparation</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">We give you a document checklist and help you gather the right evidence.</p>
</div>
<div style="display: flex; flex-direction: column; gap: 10px">
<span style="font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; color: #8A5A12; line-height: 1">3</span>
<h3 style="margin: 0; font-size: 20px; color: #14532D">Review &amp; submission</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Your adviser checks everything against current rules, then we submit.</p>
</div>
<div style="display: flex; flex-direction: column; gap: 10px">
<span style="font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; color: #8A5A12; line-height: 1">4</span>
<h3 style="margin: 0; font-size: 20px; color: #14532D">Decision</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">The Home Office makes its decision. We keep you updated and advise on next steps.</p>
</div>
</div>
</section>

<!-- Advisers / why -->
<section id="advisers" style="background: #F2F6F1">
<div style="max-width: 1200px; margin: 0 auto; padding: 88px 24px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center">
<div style="flex: 1 1 380px; min-width: 0">
{home.advisersPhoto
  ? <img src={home.advisersPhoto} alt={home.advisersPhotoAlt} width="1000" height="840" loading="lazy" style={`${photo}; height: 420px`} />
  : <div style={`${placeholder}; height: 420px`}>Add a photo in the admin: Homepage › Advisers photo</div>}
</div>
<div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 22px">
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; line-height: 1.15; font-weight: 600; color: #14532D">Meet your advisers</h2>
<p style="margin: 0; color: #3A4552">{home.advisersIntro}</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px">
<div style="display: flex; flex-direction: column; gap: 4px">
<h3 style="margin: 0; font-size: 18px; color: #14532D">Regulated advice</h3>
<p style="margin: 0; color: #3A4552; font-size: 15px">Registered with the Immigration Advice Authority. <a href="https://portal.immigrationadviceauthority.gov.uk/s/adviser-finder">Verify our registration</a></p>
</div>
<div style="display: flex; flex-direction: column; gap: 4px">
<h3 style="margin: 0; font-size: 18px; color: #14532D">One point of contact</h3>
<p style="margin: 0; color: #3A4552; font-size: 15px">The same adviser handles your case throughout.</p>
</div>
<div style="display: flex; flex-direction: column; gap: 4px">
<h3 style="margin: 0; font-size: 18px; color: #14532D">Fees agreed upfront</h3>
<p style="margin: 0; color: #3A4552; font-size: 15px">You know our fee before you commit. Consultations from {home.consultationFrom}.</p>
</div>
<div style="display: flex; flex-direction: column; gap: 4px">
<h3 style="margin: 0; font-size: 18px; color: #14532D">Checked before submission</h3>
<p style="margin: 0; color: #3A4552; font-size: 15px">Errors are caught before the Home Office sees them, not after a refusal.</p>
</div>
</div>
</div>
</div>
</section>

<!-- Reviews -->
<section style="max-width: 1200px; margin: 0 auto; padding: 88px 24px; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; align-items: flex-end">
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; line-height: 1.15; font-weight: 600; color: #14532D">What our clients say</h2>
<span style="color: #3A4552; font-size: 15px"><strong style="color: #14532D">{site.googleRating} ★</strong> from {site.googleReviewCount} Google reviews · <a href={site.googleReviewsUrl}>Read all reviews</a>{site.trustpilotUrl && site.trustpilotRating && <> · <strong style="color: #14532D">{site.trustpilotRating} ★</strong> on Trustpilot{site.trustpilotCount && <> ({site.trustpilotCount} reviews)</>} · <a href={site.trustpilotUrl} target="_blank" rel="noopener">Read on Trustpilot</a></>}</span>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px">
{home.reviews.map((r) => (
<figure style="margin: 0; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 16px">
<blockquote style="margin: 0; font-size: 17px; color: #1B2430">“{r.quote}”</blockquote>
<figcaption style="font-size: 14px; color: #55606E">{r.source}</figcaption>
</figure>
))}
</div>
</section>

<!-- Worldwide -->
<section id="worldwide" style="border-top: 1px solid #E3E7EC">
<div style="max-width: 1200px; margin: 0 auto; padding: 72px 24px; display: flex; flex-direction: column; gap: 28px">
<div style="display: flex; flex-direction: column; gap: 10px; max-width: 720px">
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 32px; line-height: 1.2; font-weight: 600; color: #14532D">Travelling abroad? We handle worldwide visas too</h2>
<p style="margin: 0; color: #3A4552">Visa and eVisa applications for UK residents, plus document legalisation and Indian passport services.</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
