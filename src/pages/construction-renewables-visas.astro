---
import IndustryVisaPage from '../components/IndustryVisaPage.astro';
---
<IndustryVisaPage
  title="Visas for Construction & Renewable Energy Workers Abroad | UVS"
  description="Work and business visas for UK construction, infrastructure and renewable energy teams working on overseas sites, from wind farms to major projects."
  crumb="Construction and renewables"
  h1="Visas for Construction and Renewable Energy Teams Abroad"
  intro="Major construction, infrastructure and renewable energy projects rely on specialist UK staff. We handle business and work visas for site teams, engineers and managers, so projects aren't held up waiting for people."
  who={[
    "Contractors and subcontractors on overseas construction sites",
    "Wind, solar and grid connection specialists",
    "Project managers, surveyors and site engineers",
    "Consultancies sending staff to client projects",
  ]}
  visas={[
    ["Business visa", "Site visits, surveys, tenders and project meetings, where the country allows it"],
    ["Work visa or permit", "Working on site, usually sponsored by the employer or main contractor in that country"],
  ]}
  sections={[
    { h: "Keeping projects on schedule", p: [
      "Work permits for site staff can take weeks and often need documents from both your company and the client. We plan applications around your mobilisation dates and flag anything that could cause a delay early.",
    ]},
    { h: "Qualifications and legalisation", p: [
      "Many countries ask for degree certificates or professional qualifications to be legalised before a work permit is issued. We handle document legalisation in-house, so there's no second supplier to chase.",
    ]},
  ]}
  checklist={[
    "Passport with enough validity and blank pages",
    "Invitation or sponsorship letter from the client or local employer",
    "Employment letter and copy of the contract",
    "Qualifications, legalised where required",
    "Medical certificates, where the country asks for them",
  ]}
  faqs={[
    { q: "Can site staff work on a business visa?", a: "Usually not. Working on site normally needs a work visa or permit. A business visa may cover site visits and meetings, depending on the country." },
    { q: "Do you legalise degree certificates for work permits?", a: "Yes, we handle document legalisation in-house alongside the visa application." },
    { q: "Can you manage visas for a whole site team?", a: "Yes. We handle group applications and can plan them around your project start dates." },
  ]}
  related={[["Oil and gas visas", "/oil-and-gas-visas/"], ["Engineering and installation visas", "/engineering-installation-visas/"]]}
/>
