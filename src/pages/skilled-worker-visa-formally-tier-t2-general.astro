---
import Page from '../layouts/Page.astro';
import Faq from '../components/Faq.astro';
import ApplyButton from '../components/ApplyButton.astro';
// SEO title, description and FAQs for this page are edited in the admin (content/special/skilled-worker-visa-formally-tier-t2-general.json).
import content from '../../content/special/skilled-worker-visa-formally-tier-t2-general.json';
import SalaryChecker from '../components/SalaryChecker.astro';
const title = content.title;
const description = content.description;
const schemas = [];
---
<Page title={title} description={description} schemas={schemas}>
<main>
<div class="page-head">
<div class="wrap">
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/uk-visa-services/">UK Visas</a></nav>
<h1>Skilled Worker visa</h1>
<p class="lead">The Skilled Worker visa (formerly Tier 2 General) lets you work in the UK for an employer with a sponsor licence. We help with new applications, extensions and changing employer.</p>
<ApplyButton url={content.applyButton} /></div></div>
<div class="wrap section page-body" style="padding-top:64px">
<div class="content">
<SalaryChecker />

<section>
<h2>Do you qualify?</h2>
<ul>
<li>You have a job offer from a UK employer with a sponsor licence</li>
<li>You have a valid Certificate of Sponsorship for the role</li>
<li>The job is at the required skill level and meets the salary threshold</li>
<li>You meet the English language requirement</li></ul></section>
<section>
<h2>Documents you&#x27;ll usually need</h2>
<ul>
<li>Passport</li>
<li>Certificate of Sponsorship reference number</li>
<li>English language evidence</li>
<li>Tuberculosis test results, if required for your country</li>
<li>Criminal record certificate, for some roles</li></ul>
<p class="soft" style="font-size:15px">We give you a full checklist for your circumstances at your consultation.</p></section>
<section>
<h2>How we help</h2>
<ul>
<li>Check your eligibility and confirm the right route at your consultation</li>
<li>Give you a personalised document checklist</li>
<li>Prepare and complete your application forms</li>
<li>Review all evidence against the current rules before submission</li>
<li>Keep you updated until you have a decision</li></ul></section>
<section id="fees">
<h2>Fees and timescales</h2>
<p>Our fee is agreed before we start. <a href="/fees/">See our fees</a>. Government fees are paid separately, and are listed on <a href="https://www.gov.uk/skilled-worker-visa">GOV.UK</a>.</p></section>

<Faq items={content.faqs} title={content.faqHeading} />

<section>
<h2>Related services</h2>
<ul>
<li><a href="/sponsor-licence-application/">Sponsor licence application</a></li>
<li><a href="/indefinite-leave-to-remain-ilr/">Indefinite Leave to Remain (ILR)</a></li></ul></section></div>
<aside class="aside">
<div class="panel">
<h2>Talk to an adviser</h2>
<p class="soft" style="font-size:16px">Book a consultation and we&#x27;ll confirm your options, what you&#x27;ll need and our fee.</p><a class="btn btn-primary" href="/contact-us/">Book a consultation</a><a href="tel:+441619562003" class="btn btn-outline">Call 0161 956 2003</a>
<p style="font-size:14px;color:var(--ink-mute)">IAA-regulated · Ref F200700144</p></div></aside></div>
<section class="wrap section">
<div class="cta-band">
<div class="stack" style="flex:1 1 460px;min-width:0;gap:10px">
<h2>Not sure which visa you need?</h2>
<p>Book a consultation and we&#x27;ll tell you your options, what you&#x27;ll need and what it will cost.</p></div>
<div class="btn-row"><a class="btn btn-gold" href="/contact-us/">Book a consultation</a><a href="tel:+441619562003" class="btn btn-ghost-light">0161 956 2003</a></div></div></section></main>
</Page>
