---
import Page from '../layouts/Page.astro';
import { site } from '../data/site.js';
---
<Page title="Thank you | Unique Visa Services" description="Your enquiry has been sent." noindex>
  <main>
    <div class="page-head"><div class="wrap">
      <h1>Thank you, your enquiry has been sent</h1>
      <p class="lead">We reply within one working day. If it's urgent, call us on <a href={`tel:${site.phoneIntl}`}>{site.phone}</a>.</p>
    </div></div>
  </main>
</Page>
