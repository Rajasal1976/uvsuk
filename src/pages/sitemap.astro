---
// Sitemap page: every page on the site, grouped by section. Updates automatically
// when pages are added in src/data/structure.js. Pages hidden from Google are left out.
import Page from '../layouts/Page.astro';
import { pages } from '../data/pages.js';
import { applications } from '../data/applications.js';
import { posts } from '../data/blog.js';

const visible = pages.filter((p) => !p.noindex);
const byGroup = (g) => visible.filter((p) => p.group === g).sort((a, b) => (a.sortKey || a.h1 || '').localeCompare(b.sortKey || b.h1 || ''));
const name = (p) => p.h1 || p.title?.split('|')[0].trim() || p.slug;
const legal = ['terms', 'privacy-policy', 'complaints', 'disclaimer'];

const groups = [
  { title: 'Main pages', links: [['Home', '/'], ['Contact us', '/contact-us/'], ['Apply online', '/apply/'], ['Search', '/search/']] },
  { title: 'UK visas and immigration', links: byGroup('uk').map((p) => [name(p), `/${p.slug}/`]) },
  { title: 'Employers', links: byGroup('employer').map((p) => [name(p), `/${p.slug}/`]) },
  { title: 'Worldwide visas and travel services', links: byGroup('worldwide').map((p) => [name(p), `/${p.slug}/`]) },
  { title: 'Online application forms', links: applications.map((a) => [a.title, `/apply/${a.slug}/`]) },
  { title: 'Blog', links: [['All blog posts', '/blog/'], ...posts.map((p) => [p.h1, `/blog/${p.slug}/`])] },
  { title: 'Our office', links: byGroup('local').map((p) => [name(p), `/${p.slug}/`]) },
  { title: 'About us', links: byGroup('company').filter((p) => !legal.includes(p.slug)).map((p) => [name(p), `/${p.slug}/`]) },
  { title: 'Legal', links: legal.map((s) => visible.find((p) => p.slug === s)).filter(Boolean).map((p) => [name(p), `/${p.slug}/`]) },
].filter((g) => g.links.length);
---
<Page title="Sitemap | Unique Visa Services" description="Every page on the Unique Visa Services website: UK visas and immigration, worldwide visas, online application forms and company information.">
  <main>
    <div class="page-head">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a></nav>
        <h1>Sitemap</h1>
        <p class="lead">Every page on our website, in one place.</p>
      </div>
    </div>
    <div class="wrap section sitemap" style="padding-top:56px">
      {groups.map((g) => (
        <section>
          <h2>{g.title}</h2>
          <ul>{g.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
        </section>
      ))}
    </div>
  </main>
</Page>

<style>
  .sitemap { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px 48px; align-items: start; }
  .sitemap h2 { font-size: 22px; margin: 0 0 12px; }
  .sitemap ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .sitemap a { color: var(--green-800); }
</style>
