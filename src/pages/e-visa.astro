---
// eVisas page (same address as the old site: /e-visa/). Countries come from src/data/evisas.js.
// Text, FAQs, prices and Google details are edited in the admin (content/pages/e-visa.json).
import Page from '../layouts/Page.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import PriceTables from '../components/PriceTables.astro';
import { site } from '../data/site.js';
import { evisaContinents } from '../data/evisas.js';
import content from '../../content/pages/e-visa.json';
---
<Page title={content.title} description={content.description}>
  <main>
    <div class="page-head">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/worldwide-visas/">Worldwide Visas</a></nav>
        <h1>{content.h1}</h1>
        {content.intro && <p class="lead">{content.intro}</p>}
        <ul class="evisa-jump" aria-label="Jump to a continent">
          {evisaContinents.map((g) => <li><a href={`#${g.id}`}>{g.name}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="wrap section page-body" style="padding-top:64px">
      <div class="content">
        {evisaContinents.map((g) => (
          <section class="evisa-continent" id={g.id}>
            <h2>{g.name}</h2>
            <div class="evisa-grid">
              {g.countries.map((k) => (
                <a href={k.page || '/contact-us/'} class="card" id={k.id}>
                  <h3>{k.name}</h3>
                  <p>{k.type}</p>
                  <span class="more">{k.page ? 'Find out more' : 'Apply with us'}</span>
                </a>
              ))}
            </div>
          </section>
        ))}

        <section>
          <h2>What you’ll usually need</h2>
          <ul>
            <li>A scan or photo of your passport photo page. Your passport should be valid for at least six months.</li>
            <li>A recent photo of you on a plain white background</li>
            <li>Your travel dates and where you’ll stay</li>
            <li>Some countries ask for more, such as an invitation letter. We’ll tell you exactly what’s needed.</li>
          </ul>
        </section>

        <PriceTables prices={content.prices} kind="evisa" />

        <Faq items={content.faqs} title={content.faqHeading || 'Common questions'} />
      </div>
      <aside class="aside">
        <div class="panel">
          <h2>Not sure if you need an eVisa?</h2>
          <p class="soft" style="font-size:16px">Tell us where you’re going and your nationality, and we’ll tell you what you need.</p>
          <a href="/contact-us/" class="btn btn-primary">Ask us</a>
          <a href={`tel:${site.phoneIntl}`} class="btn btn-outline">Call {site.phone}</a>
          <p style="font-size:14px;color:var(--ink-mute)">IAA-regulated · Ref {site.iaaRef}</p>
        </div>
      </aside>
    </div>

    <CtaBand />
  </main>
</Page>
