---
// "On this page" list of jump links. Shown in the sidebar on desktop and as a tap-to-open bar on mobile.
// Only appears on pages with 4 or more sections, so short pages stay clean.
// Pages built from the main template pass `items`. Special pages use `auto`, which builds the list
// from the page's headings in the browser.
const { items = [], mobile = false, auto = false } = Astro.props;
const show = auto || items.length >= 4;
const list = items.map((i) => ({ href: `#${i.id}`, label: i.label }));
---
{show && (mobile ? (
  <details class="toc toc-mobile" data-toc-auto={auto ? '' : undefined} hidden={auto}>
    <summary>On this page</summary>
    <ol>{list.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ol>
  </details>
) : (
  <nav class="toc toc-desktop" aria-label="On this page" data-toc-auto={auto ? '' : undefined} hidden={auto}>
    <p class="toc-title">On this page</p>
    <ol>{list.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ol>
  </nav>
))}
{auto && !mobile && (
  <script is:inline>
    (function () {
      var boxes = document.querySelectorAll('[data-toc-auto]');
      var content = document.querySelector('.content');
      if (!boxes.length || !content) return;
      var slug = function (h) { return h.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60); };
      var seen = {}, items = [];
      content.querySelectorAll('h2').forEach(function (h) {
        if (h.closest('.toc')) return;
        var target = h.closest('section') && h.closest('section').querySelectorAll('h2').length === 1 ? h.closest('section') : h;
        var id = target.id || slug(h.textContent);
        if (!id || seen[id]) return;
        seen[id] = true; target.id = id; target.style.scrollMarginTop = '24px';
        items.push({ id: id, label: h.textContent.trim() });
      });
      if (items.length < 4) return;
      boxes.forEach(function (box) {
        var ol = box.querySelector('ol');
        items.forEach(function (i) { var li = document.createElement('li'), a = document.createElement('a'); a.href = '#' + i.id; a.textContent = i.label; li.appendChild(a); ol.appendChild(li); });
        box.hidden = false;
      });
    })();
  </script>
)}
