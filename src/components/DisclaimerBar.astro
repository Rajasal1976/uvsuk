---
// Short disclaimer shown above the footer on every page, linking to the full Disclaimer page.
// The wording is edited in the admin: Business details → Disclaimer (short version).
import settings from '../../content/settings.json';
const text = (settings.disclaimerShort || '').trim() ||
  'Unique Visa Services Ltd is a private visa assistance provider and is not affiliated with any government, embassy or consulate. We charge a consultation fee in addition to any government or consular visa application charges. You can also apply directly through the official government or consulate website of the country you wish to travel to.';
---
<section class="disc" aria-labelledby="disc-title">
  <div class="wrap">
    <h2 id="disc-title">Disclaimer</h2>
    <p>{text} <a href="/disclaimer/">Read the full disclaimer</a></p>
  </div>
</section>

<style>
  .disc { background: #F4F6F3; border-top: 1px solid var(--line); padding: 28px 0; margin-top: 56px; }
  .disc h2 { font-family: 'Source Serif 4', Georgia, serif; font-size: 20px; margin: 0 0 8px; color: var(--green-800); letter-spacing: .02em; }
  .disc p { margin: 0; max-width: 1000px; font-size: 15px; line-height: 1.6; color: var(--ink-soft, #3A4552); }
  .disc a { color: var(--green-800); font-weight: 600; }
</style>
