---
// Spouse and partner visa financial requirement calculator.
// Rules (Appendix FM, as at November 2026):
// - £29,000 for applications under the rules from 11 April 2024.
// - People first granted before 11 April 2024 under the old rules keep £18,600,
//   plus £3,800 for the first non-British child and £2,400 for each other child.
// - Cash savings above £16,000 can make up a shortfall: shortfall x 2.5 for a first
//   visa or extension, x 1 for Indefinite Leave to Remain.
// - Partners on certain benefits show "adequate maintenance" instead.
// Change the figures below if the rules change.
import CalcLead from './CalcLead.astro';
---
<div class="vt-wrap" id="fin-tool">
  <div class="vt">
    <div class="vt-in">
      <fieldset>
        <legend>Which application is this?</legend>
        <label class="vt-opt"><input type="radio" name="fin-stage" value="first" checked><span>First partner visa<small>Applying from outside the UK, or switching into the partner route</small></span></label>
        <label class="vt-opt"><input type="radio" name="fin-stage" value="ext"><span>Extension<small>Your second partner visa, after the first 2½ years</small></span></label>
        <label class="vt-opt"><input type="radio" name="fin-stage" value="ilr"><span>Indefinite Leave to Remain<small>Settlement after 5 years on the partner route</small></span></label>
      </fieldset>

      <fieldset id="fin-rules-wrap" hidden>
        <legend>When was your first partner visa granted?</legend>
        <label class="vt-opt"><input type="radio" name="fin-rules" value="new" checked><span>On or after 11 April 2024</span></label>
        <label class="vt-opt"><input type="radio" name="fin-rules" value="old"><span>Before 11 April 2024<small>You may keep the old £18,600 threshold</small></span></label>
      </fieldset>

      <div class="vt-field" id="fin-kids-wrap" hidden>
        <label for="fin-kids">Children applying who aren’t British or settled</label>
        <input type="number" id="fin-kids" min="0" max="10" step="1" value="0" inputmode="numeric">
      </div>

      <label class="vt-check"><input type="checkbox" id="fin-exempt"><span>My partner receives a disability or carer’s benefit, such as PIP, Disability Living Allowance, Attendance Allowance or Carer’s Allowance</span></label>

      <div class="vt-field">
        <label for="fin-partner">Your partner’s yearly income before tax</label>
        <div class="vt-money"><input type="number" id="fin-partner" min="0" step="100" inputmode="numeric" placeholder="0"></div>
        <p class="vt-hint">From a job, self-employment or pension</p>
      </div>
      <div class="vt-field">
        <label for="fin-you">Your own yearly income before tax</label>
        <div class="vt-money"><input type="number" id="fin-you" min="0" step="100" inputmode="numeric" placeholder="0"></div>
        <p class="vt-hint">Only counts if you’re already in the UK with permission to work</p>
      </div>
      <div class="vt-field">
        <label for="fin-other">Other yearly income</label>
        <div class="vt-money"><input type="number" id="fin-other" min="0" step="100" inputmode="numeric" placeholder="0"></div>
        <p class="vt-hint">For example rent from a property, or dividends</p>
      </div>
      <div class="vt-field">
        <label for="fin-savings">Cash savings held for at least 6 months</label>
        <div class="vt-money"><input type="number" id="fin-savings" min="0" step="100" inputmode="numeric" placeholder="0"></div>
        <p class="vt-hint">Yours, your partner’s, or joint</p>
      </div>
    </div>
    <div class="vt-out" aria-live="polite"><div id="fin-out"><p class="vt-empty">Enter your income and savings to see if you meet the requirement.</p></div></div>
  </div>
  <CalcLead tool="financial-requirement" />
</div>

<script>
  const NEW_THRESHOLD = 29000;
  const OLD_BASE = 18600, OLD_FIRST_CHILD = 3800, OLD_EACH_CHILD = 2400;
  const SAVINGS_FLOOR = 16000;

  const root = document.getElementById('fin-tool');
  const $ = (s) => root.querySelector(s);
  const money = (n) => '£' + Math.round(n).toLocaleString('en-GB');
  const num = (id) => Math.max(0, parseFloat($(id).value) || 0);
  const row = (cls, icon, html) => `<div class="vt-res ${cls}"><i>${icon}</i><span>${html}</span></div>`;

  function calc() {
    const stage = root.querySelector('input[name="fin-stage"]:checked').value;
    $('#fin-rules-wrap').hidden = stage === 'first';
    const rules = stage === 'first' ? 'new' : root.querySelector('input[name="fin-rules"]:checked').value;
    $('#fin-kids-wrap').hidden = rules !== 'old';
    const kids = rules === 'old' ? Math.min(10, Math.floor(num('#fin-kids'))) : 0;
    const threshold = rules === 'old' ? OLD_BASE + (kids > 0 ? OLD_FIRST_CHILD : 0) + Math.max(0, kids - 1) * OLD_EACH_CHILD : NEW_THRESHOLD;
    const mult = stage === 'ilr' ? 1 : 2.5;
    const income = num('#fin-partner') + num('#fin-you') + num('#fin-other');
    const savings = num('#fin-savings');
    const out = $('#fin-out');
    const lead = document.querySelector('#lead-financial-requirement [name="result"]');
    const stageLabel = { first: 'first partner visa', ext: 'extension', ilr: 'ILR' }[stage];

    if ($('#fin-exempt').checked) {
      out.innerHTML = '<p class="vt-verdict">The income threshold doesn’t apply</p>'
        + row('info', 'i', 'Because your partner receives one of these benefits, you show <b>adequate maintenance</b> instead: that you can support yourselves without claiming extra public funds.')
        + row('info', 'i', 'This is worked out from your household income, housing costs and family size. We can do this calculation for you.');
      if (lead) lead.value = `Stage: ${stageLabel}. Partner receives an exempt benefit, so adequate maintenance applies.`;
      return;
    }
    if (!income && !savings) {
      out.innerHTML = '<p class="vt-empty">Enter your income and savings to see if you meet the requirement.</p>';
      if (lead) lead.value = '';
      return;
    }

    let html = '', verdict = '', summary = '';
    const savingsOnly = SAVINGS_FLOOR + threshold * mult;
    if (income >= threshold) {
      verdict = 'You meet the income requirement';
      html += row('ok', '✓', `Income counted: <b>${money(income)}</b> a year (you need ${money(threshold)})`);
      if (savings) html += row('info', 'i', 'You don’t need to use your savings, but keep the evidence in case your income changes.');
      summary = `Meets threshold on income: ${money(income)} vs ${money(threshold)}.`;
    } else {
      const shortfall = threshold - income;
      const needed = SAVINGS_FLOOR + shortfall * mult;
      html += row('info', 'i', `Income counted: <b>${money(income)}</b> a year. Shortfall: <b>${money(shortfall)}</b>.`);
      if (savings >= needed) {
        verdict = 'You meet it with your savings';
        html += row('ok', '✓', `Savings needed to cover the shortfall: <b>${money(needed)}</b>. You have ${money(savings)}.<br><small>£16,000 plus ${mult === 1 ? 'the shortfall' : '2.5 × the shortfall'}</small>`);
        summary = `Meets with income ${money(income)} plus savings ${money(savings)} (needs ${money(needed)}).`;
      } else {
        verdict = 'You don’t meet it yet';
        html += row('bad', '!', `Savings needed to cover the shortfall: <b>${money(needed)}</b>. You have ${money(savings)}, so you’re <b>${money(needed - savings)}</b> short.<br><small>£16,000 plus ${mult === 1 ? 'the shortfall' : '2.5 × the shortfall'}</small>`);
        html += row('info', 'i', `With savings alone you’d need <b>${money(savingsOnly)}</b>.`);
        summary = `Short: income ${money(income)}, savings ${money(savings)}, savings needed ${money(needed)}.`;
      }
    }
    out.innerHTML = `<p class="vt-verdict">${verdict}</p>` + html
      + '<p class="vt-note">Self-employed income and some other income can’t be combined with savings, and each type of income needs specific evidence for set periods. This calculator is a guide: we confirm your exact position before you apply.</p>';
    if (lead) lead.value = `Stage: ${stageLabel}. Threshold ${money(threshold)}${rules === 'old' ? ` (old rules, ${kids} children)` : ''}. ${summary}`;
  }
  root.addEventListener('input', calc);
  root.addEventListener('change', calc);
  calc();
</script>
