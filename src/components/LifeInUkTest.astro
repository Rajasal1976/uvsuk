---
// Life in the UK practice test: 24 random questions from src/data/lituk-questions.js,
// 45 minutes, 18 correct (75%) to pass, like the real test. Answers are shuffled each time.
import CalcLead from './CalcLead.astro';
import { questions } from '../data/lituk-questions.js';
---
<div class="vt-wrap" id="lt-tool">
  <div class="vt-lt">
    <div id="lt-start">
      <p class="vt-verdict">Free practice test</p>
      <ul class="vt-lt-facts">
        <li><b>24</b> questions</li>
        <li><b>45</b> minutes</li>
        <li><b>18</b> correct to pass</li>
      </ul>
      <p>Each test picks 24 questions at random from our bank of {questions.length}, so every attempt is different.</p>
      <label class="vt-check"><input type="checkbox" id="lt-learn"><span>Learning mode: show the answer after each question</span></label>
      <button type="button" class="btn btn-gold" id="lt-go">Start the practice test</button>
    </div>

    <div id="lt-quiz" hidden>
      <div class="vt-lt-bar">
        <span id="lt-count">Question 1 of 24</span>
        <span id="lt-timer" aria-live="off">45:00</span>
      </div>
      <div class="vt-lt-progress" aria-hidden="true"><span id="lt-progress"></span></div>
      <fieldset class="vt-lt-q">
        <legend id="lt-question"></legend>
        <div id="lt-options" class="vt-lt-options"></div>
      </fieldset>
      <div id="lt-feedback" class="vt-lt-feedback" aria-live="polite"></div>
      <div class="vt-lt-nav">
        <button type="button" class="btn btn-outline" id="lt-quit">End test</button>
        <button type="button" class="btn btn-gold" id="lt-next" disabled>Next question</button>
      </div>
    </div>

    <div id="lt-result" hidden aria-live="polite"></div>
  </div>
  <CalcLead tool="life-in-the-uk-test" heading="Applying for ILR or citizenship?" text="Once you’ve passed, we can check you’re ready to apply and prepare your application so it’s right first time." />
</div>
<script type="application/json" id="lt-data" set:html={JSON.stringify(questions)}></script>

<script>
  const COUNT = 24, PASS = 18, MINUTES = 45;
  const bank = JSON.parse(document.getElementById('lt-data').textContent);
  const root = document.getElementById('lt-tool');
  const $ = (s) => root.querySelector(s);
  const shuffle = (a) => { a = a.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
  let test = [], i = 0, answers = [], learn = false, timer = null, endAt = 0, locked = false;

  function start() {
    learn = $('#lt-learn').checked;
    test = shuffle(bank).slice(0, COUNT).map((q) => {
      const order = q.o.length === 2 ? [0, 1] : shuffle(q.o.map((_, k) => k));
      return { ...q, opts: order.map((k) => q.o[k]), correct: order.indexOf(q.a) };
    });
    i = 0; answers = new Array(COUNT).fill(null);
    $('#lt-start').hidden = true; $('#lt-result').hidden = true; $('#lt-quiz').hidden = false;
    endAt = Date.now() + MINUTES * 60000;
    clearInterval(timer); timer = setInterval(tick, 1000); tick();
    show();
  }
  function tick() {
    const left = Math.max(0, endAt - Date.now());
    const m = Math.floor(left / 60000), s = Math.floor((left % 60000) / 1000);
    $('#lt-timer').textContent = `${m}:${String(s).padStart(2, '0')}`;
    if (!left) finish(true);
  }
  function show() {
    const q = test[i]; locked = false;
    $('#lt-count').textContent = `Question ${i + 1} of ${COUNT}`;
    $('#lt-progress').style.width = `${(i / COUNT) * 100}%`;
    $('#lt-question').textContent = q.q;
    $('#lt-options').innerHTML = q.opts.map((o, k) => `<label class="vt-opt"><input type="radio" name="lt-opt" value="${k}"><span>${o}</span></label>`).join('');
    $('#lt-feedback').innerHTML = '';
    $('#lt-next').disabled = true;
    $('#lt-next').textContent = i === COUNT - 1 ? 'See my result' : 'Next question';
  }
  $('#lt-options').addEventListener('change', (e) => {
    if (locked) return;
    const k = +e.target.value; answers[i] = k; $('#lt-next').disabled = false;
    if (learn) {
      locked = true;
      root.querySelectorAll('input[name="lt-opt"]').forEach((r) => { r.disabled = true; });
      const q = test[i], ok = k === q.correct;
      $('#lt-feedback').innerHTML = `<div class="vt-res ${ok ? 'ok' : 'bad'}"><i>${ok ? '✓' : '!'}</i><span><b>${ok ? 'Correct.' : `Not quite. The answer is: ${q.opts[q.correct]}.`}</b> ${q.e}</span></div>`;
    }
  });
  $('#lt-next').addEventListener('click', () => { if (i < COUNT - 1) { i++; show(); } else finish(false); });
  $('#lt-quit').addEventListener('click', () => finish(false));
  $('#lt-go').addEventListener('click', start);

  function finish(timeUp) {
    clearInterval(timer);
    const score = test.reduce((n, q, k) => n + (answers[k] === q.correct ? 1 : 0), 0);
    const passed = score >= PASS;
    const wrong = test.map((q, k) => ({ q, k })).filter(({ q, k }) => answers[k] !== q.correct);
    $('#lt-quiz').hidden = true;
    const r = $('#lt-result'); r.hidden = false;
    r.innerHTML = `<p class="vt-verdict">${passed ? 'Pass' : 'Not a pass yet'}: ${score} out of ${COUNT}</p>`
      + `<p>${timeUp ? 'Time’s up. ' : ''}${passed ? 'Well done. You’d have passed the real test with this score.' : `You need ${PASS} correct answers to pass. Keep practising: every test uses different questions.`}</p>`
      + (wrong.length ? `<h3 class="vt-lt-h">Questions to review</h3>` + wrong.map(({ q, k }) => `<div class="vt-res bad"><i>!</i><span><b>${q.q}</b><br>${answers[k] === null ? 'Not answered.' : `You answered: ${q.opts[answers[k]]}.`} Correct answer: <b>${q.opts[q.correct]}</b>.<br><small>${q.e}</small></span></div>`).join('') : '')
      + '<p style="margin-top:16px"><button type="button" class="btn btn-gold" id="lt-again">Take another test</button></p>';
    r.querySelector('#lt-again').addEventListener('click', start);
    const lead = document.querySelector('#lead-life-in-the-uk-test [name="result"]');
    if (lead) lead.value = `Practice test score ${score}/${COUNT} (${passed ? 'pass' : 'not yet a pass'}).`;
    r.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
</script>

<style is:global>
.vt-lt { border: 1px solid var(--line, #dfe3e0); border-radius: 6px; background: #fff; padding: 32px; display: grid; gap: 14px; }
.vt-lt [hidden] { display: none !important; }
#lt-start, #lt-quiz, #lt-result { display: grid; gap: 14px; }
.vt-lt-facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
.vt-lt-facts li { background: var(--green-50, #f1f6f3); border-radius: 4px; padding: 10px 16px; font-size: 15px; }
.vt-lt-facts b { font-size: 20px; margin-right: 4px; }
.vt-lt-bar { display: flex; justify-content: space-between; font-size: 14.5px; font-weight: 600; color: var(--ink-mute, #5d6862); }
#lt-timer { font-variant-numeric: tabular-nums; }
.vt-lt-progress { height: 6px; background: var(--green-50, #f1f6f3); border-radius: 3px; overflow: hidden; }
.vt-lt-progress span { display: block; height: 100%; background: var(--green-800, #1d4b37); transition: width .2s; }
.vt-lt-q { border: 0; padding: 0; margin: 0; }
.vt-lt-q legend { font-family: var(--serif, Georgia, serif); font-size: 22px; line-height: 1.3; color: var(--ink, #1c2420); margin-bottom: 14px; padding: 0; }
.vt-lt-options { display: grid; gap: 8px; }
.vt-lt-options .vt-opt span { padding: 13px 16px; font-size: 15.5px; }
.vt-lt-options .vt-opt input:disabled + span { cursor: default; }
.vt-lt-nav { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
.vt-lt-nav .btn:disabled { opacity: .5; cursor: not-allowed; }
.vt-lt-h { margin: 8px 0 0; font-size: 18px; }
@media (max-width: 760px) { .vt-lt { padding: 20px; } .vt-lt-q legend { font-size: 19px; } }
</style>
