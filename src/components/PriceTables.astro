---
// Price table for travel visa and eVisa pages, plus delivery charges.
// Rows come from each page's "Price table" in the admin. Delivery prices are in Business details.
// The total is worked out automatically when the processing fee and our fee are both amounts.
import { site } from '../data/site.js';
const { prices = [], kind = 'travel', applyUrl = '' } = Astro.props;
// "Start your application" goes to the online application form where the page has one, otherwise the enquiry form
const startUrl = String(applyUrl || '').startsWith('/apply/') ? applyUrl : '/contact-us/';
const rows = prices.filter((r) => r && r.service);
const amount = (v) => { const m = String(v || '').replace(/,/g, '').match(/^\s*£?\s*(\d+(?:\.\d{1,2})?)\s*$/); return m ? Number(m[1]) : null; };
const money = (n) => `£${Number.isInteger(n) ? n.toLocaleString('en-GB') : n.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
// The total always adds itself up from the embassy fee and our fee
const totalFor = (r) => {
  const a = amount(r.processingFee), b = amount(r.fee);
  return a !== null && b !== null ? money(a + b) : '';
};
const feeName = kind === 'evisa' ? 'Official fee' : 'Embassy fee (incl. VAT)';
const call = `tel:${site.phoneIntl}`;
---
<section id="fees">
  <h2>Fees and timescales</h2>
  {rows.length > 0 && (
    <div class="table-wrap">
      <table class="data-table price-table">
        <thead><tr><th scope="col">Service</th><th scope="col">Visa length</th><th scope="col">{feeName}</th><th scope="col">Our fee</th><th scope="col">Total</th></tr></thead>
        <tbody>
          {rows.map((r) => {
            const total = totalFor(r);
            return (
              <tr>
                <th scope="row" data-label="Service">
                  {r.service}
                  {r.included && <span style="display:block;font-weight:400;font-size:15px;color:var(--ink-soft);white-space:normal;margin-top:4px">{r.included}</span>}
                </th>
                <td data-label="Visa length">{r.validity || r.processing || 'Ask us'}</td>
                <td data-label={feeName}>{r.processingFee || '–'}</td>
                <td data-label="Our fee">{r.fee || <a href={call}>Call for price</a>}</td>
                <td data-label="Total" class={total ? 'price' : undefined}>{total || '–'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
  <p class="soft" style="font-size:15px">{kind === 'evisa'
    ? 'The official fee is the fee charged by the country’s eVisa system. It can change, so we confirm it before you pay.'
    : 'The embassy fee includes the visa centre charges and VAT. It can depend on your nationality and the number of entries, so we confirm it before you pay.'}</p>

  {kind === 'travel' && site.delivery.length > 0 && (
    <>
      <h3 style="margin-top:32px">Returning your passport</h3>
      <div class="table-wrap">
        <table class="data-table price-table">
          <thead><tr><th scope="col">Delivery option</th><th scope="col">Price</th></tr></thead>
          <tbody>
            {site.delivery.map((d) => (
              <tr><th scope="row" data-label="Delivery option">{d.service}</th><td data-label="Price" class={/\d/.test(d.price) ? 'price' : undefined}>{d.price}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
  {kind === 'evisa' && site.evisaDelivery && (
    <>
      <h3 style="margin-top:32px">Delivery</h3>
      <p>Your eVisa is sent to you electronically, so there’s no passport to post. Delivery is a flat <strong>{site.evisaDelivery}</strong>.</p>
    </>
  )}
  <div class="btn-row" style="margin-top:24px"><a class="btn btn-primary" href={startUrl}>Start your application</a></div>
</section>
