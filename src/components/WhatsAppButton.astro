---
// Floating WhatsApp button on every page. The number comes from the admin:
// Business details → WhatsApp link (e.g. https://wa.me/447908242929). Empty = no button.
import { site } from '../data/site.js';
const { pageTitle = '' } = Astro.props;
const link = (site.social || []).find((x) => x.name === 'WhatsApp')?.url || '';
const topic = pageTitle.split('|')[0].trim();
const text = topic ? `Hello, I'm contacting you from your website about: ${topic}` : 'Hello, I have a question.';
const href = link ? `${link}${link.includes('?') ? '&' : '?'}text=${encodeURIComponent(text)}` : '';
---
{href && (
  <a class="wa-float" href={href} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
    <svg aria-hidden="true" viewBox="0 0 32 32" width="30" height="30">
      <path fill="#fff" d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.3.6 4.5 1.8 6.4L3 29l7.2-1.9a12.8 12.8 0 0 0 5.8 1.4c7 0 12.7-5.7 12.7-12.6S23 3 16 3Zm0 23.1c-1.9 0-3.8-.5-5.4-1.5l-.4-.2-4.3 1.1 1.1-4.2-.3-.4a10.3 10.3 0 0 1-1.6-5.5C5.1 9.9 10 5.3 16 5.3s10.5 4.6 10.5 10.3S22 26.1 16 26.1Zm5.8-7.7c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.5 8.5 0 0 1-4.2-3.7c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.6 3.6 0 0 0-1.1 2.7 6.3 6.3 0 0 0 1.3 3.3 14.3 14.3 0 0 0 5.5 4.8c2 .9 2.8.9 3.8.8.6-.1 1.9-.8 2.2-1.5s.3-1.4.2-1.5-.3-.2-.6-.3Z"/>
    </svg>
    <span class="wa-label">WhatsApp us</span>
  </a>
)}

<style>
  .wa-float {
    position: fixed; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom, 0px)); z-index: 60;
    display: inline-flex; align-items: center; gap: 10px;
    height: 58px; min-width: 58px; padding: 0 14px; box-sizing: border-box; justify-content: center;
    border-radius: 999px; background: #25D366; color: #fff; text-decoration: none;
    font: 600 16px/1 Inter, system-ui, sans-serif;
    box-shadow: 0 6px 20px rgba(0, 0, 0, .25);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .wa-float:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(0, 0, 0, .3); color: #fff; }
  .wa-float:focus-visible { outline: 3px solid #F2C46D; outline-offset: 3px; }
  .wa-label { padding-right: 4px; }
  /* On phones, just the round icon so it doesn't cover the page */
  @media (max-width: 640px) { .wa-label { display: none; } .wa-float { padding: 0; width: 58px; } }
  @media (prefers-reduced-motion: reduce) { .wa-float { transition: none; } }
  @media print { .wa-float { display: none; } }
</style>
