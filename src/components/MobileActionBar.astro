---
// Phones only: a bar fixed to the bottom of the screen with "Apply now" and "Call".
// "Apply now" uses the page's own apply form when it has one (from the visa bar), otherwise booking.
// Not shown on the apply forms, contact page or thank-you page.
import { site } from '../data/site.js';
const path = Astro.url.pathname;
const skip = /^\/(apply|contact-us|thank-you|admin)(\/|$)/.test(path);
---
{!skip && (
  <nav class="mab" aria-label="Quick actions">
    <a class="mab-apply" href={site.bookingUrl}>Book a consultation</a>
    <a class="mab-call" href={`tel:${site.phoneIntl}`}>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/></svg>
      Call us
    </a>
  </nav>
  <script is:inline>
    (function () {
      document.body.classList.add('has-mab');
      var bar = document.querySelector('.visa-bar[data-apply]');
      var a = document.querySelector('.mab-apply');
      if (bar && a) { a.href = bar.getAttribute('data-apply'); a.textContent = 'Apply now'; }
    })();
  </script>
)}
