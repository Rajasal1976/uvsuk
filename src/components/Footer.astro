---
import { site } from '../data/site.js';
const year = new Date().getFullYear();
// Simple icons for the social links (drawn in the footer's white)
const icons = {
  'Facebook': '<path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3.1h-3V8.5c0-.9.3-1.5 1.6-1.5h1.6V4.2c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.3H7.9v3.1h2.6V21z"/>',
  'Instagram': '<rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>',
  'LinkedIn': '<path fill="currentColor" d="M4.5 9h3.6v11H4.5zM6.3 3.6a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2zM10.3 9h3.4v1.5h.1c.5-.9 1.7-1.8 3.4-1.8 3.7 0 4.3 2.4 4.3 5.4V20h-3.6v-5.2c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V20h-3.6z"/>',
  'X (Twitter)': '<path fill="currentColor" d="M17.6 3.5h3l-6.6 7.5 7.8 9.5h-6.1l-4.8-5.8-5.5 5.8H2.4l7-7.9L1.9 3.5h6.2l4.3 5.3zm-1 15.3h1.7L7.5 5.1H5.7z"/>',
  'TikTok': '<path fill="currentColor" d="M16.3 3c.3 2.3 1.6 3.7 3.9 3.9v3c-1.4.1-2.7-.3-3.9-1v5.6a5.6 5.6 0 1 1-5.6-5.6h.6v3.1a2.5 2.5 0 1 0 1.8 2.4V3z"/>',
  'YouTube': '<path fill="currentColor" d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.6 2.6 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.6 2.6 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3z"/>',
  'WhatsApp': '<path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M3.5 20.5l1.3-4a8.5 8.5 0 1 1 3.2 3z"/><path fill="currentColor" d="M9.2 8.1c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 1.8c.1.2 0 .5-.1.6l-.5.6c-.1.2-.2.3 0 .6.6 1 1.4 1.8 2.5 2.3.3.1.4.1.6-.1l.6-.7c.2-.2.4-.2.6-.1l1.8.8c.3.1.4.3.4.5 0 .5-.2 1.2-.8 1.6-.6.4-1.5.5-2.6.1-1.9-.7-3.6-2.2-4.6-4-.7-1.3-.7-2.4-.5-3.1z"/>',
};

---
<footer class="footer" id="contact">
  <div class="wrap">
    <div class="footer-cols">
      <div><span class="footer-brand">{site.legalName}</span><span>UK immigration and visa specialists in Manchester since {site.since}.</span>
        {site.social.length > 0 && (
          <ul class="footer-social" aria-label="Follow us">
            {site.social.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener" aria-label={`${site.name} on ${s.name}`} title={s.name}><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" set:html={icons[s.name]} /></a></li>
            ))}
          </ul>
        )}
      </div>
      <div><span class="footer-title">Visit us</span><span>{site.address.line1}<br />{site.address.city} {site.address.postcode}</span><span>{site.hours}</span></div>
      <div><span class="footer-title">Contact</span><a href={`tel:${site.phoneIntl}`}>{site.phone}</a><a href={`mailto:${site.email}`}>{site.email}</a></div>
      <div><span class="footer-title">Company</span><a href="/about-us/">About us</a><a href="/fees/">Fees</a><a href="/faqs/">FAQs</a><a href="/complaints/">Complaints procedure</a><a href="/privacy-policy/">Privacy policy</a><a href="/terms/">Terms and conditions</a><a href="/sitemap/">Sitemap</a></div>
    </div>
    <div class="footer-legal">
      <span>{site.legalName} is registered with and regulated by the Immigration Advice Authority (IAA), ref {site.iaaRef} ({site.iaaLevel}). <a href={site.iaaFinder}>Check our registration</a>. We are a private advisory service and are not affiliated with the Home Office or any government. You can apply directly through official government websites. Our fees are charged in addition to government application fees. <a href="/disclaimer/">Disclaimer</a>.</span>
      <span>© {year} {site.legalName}. Company no. {site.companyNumber}.</span>
    </div>
  </div>
</footer>

<style>
  .footer-social { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 12px 0 0; padding: 0; }
  .footer-social a { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid #2C5E40; color: #fff; }
  .footer-social a:hover { background: #fff; color: var(--green-900); border-color: #fff; }
  .footer-social a:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
</style>
