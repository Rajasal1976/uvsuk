---
// Homepage. Most of the text here is edited in the admin (content/home.json and settings.json).
import Page from '../layouts/Page.astro';
import home from '../../content/home.json';
import { site } from '../data/site.js';
const title = home.title;
const description = home.description;
const schemas = [JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: home.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
})];
const tel = `tel:${site.phoneIntl}`;
const photo = 'width: 100%; border-radius: 12px; object-fit: cover; display: block';
const placeholder = 'background: #D6E3DA; border-radius: 12px; display: flex; align-items: center; justify-content: center; text-align: center; color: #3A4552; font-size: 15px; padding: 24px; box-sizing: border-box';
---
<Page title={title} description={description} schemas={schemas}>
<main id="main">
<!-- Hero -->
<section style="background: #F2F6F1">
<div style="max-width: 1200px; margin: 0 auto; padding: 80px 24px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center">
<div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
<p style="margin: 0; font-size: 14px; font-weight: 600; letter-spacing: 0.08em; color: #8A5A12">{home.heroEyebrow}</p>
<h1 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 54px; line-height: 1.1; font-weight: 600; color: #14532D">{home.heroHeading}</h1>
<p style="margin: 0; font-size: 19px; color: #3A4552; max-width: 560px">{home.heroIntro}</p>
<div style="display: flex; flex-wrap: wrap; gap: 14px">
<a href={site.bookingUrl} style="background: #14532D; color: #FFFFFF; text-decoration: none; padding: 16px 28px; border-radius: 6px; font-weight: 600">Book a consultation</a>
<a href={tel} style="background: #FFFFFF; color: #14532D; text-decoration: none; padding: 15px 27px; border-radius: 6px; font-weight: 600; border: 1px solid #14532D">Call {site.phone}</a>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px 32px; font-size: 15px; color: #3A4552; padding-top: 8px">
<span><strong style="color: #14532D">{site.googleRating} ★</strong> on Google, Trustpilot &amp; Trustindex</span>
<span><strong style="color: #14532D">{site.yearsInPractice}</strong> years in practice</span>
<span><strong style="color: #14532D">{site.applicationsHandled}</strong> applications handled</span>
</div>
</div>
<div style="flex: 1 1 400px; min-width: 0">
{home.heroPhoto
  ? <img src={home.heroPhoto} alt={home.heroPhotoAlt} width="1200" height="880" fetchpriority="high" style={`${photo}; height: 440px`} />
  : <div style={`${placeholder}; height: 440px`}>Add a photo in the admin: Homepage › Main photo</div>}
</div>
</div>
<div style="max-width: 1200px; margin: 0 auto; padding: 0 24px 72px; display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 24px">
<div style="background: #FFFFFF; border: 1px solid #DCE6DF; border-radius: 12px; padding: 28px; display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0; font-size: 22px; color: #14532D">Check your visa requirements</h2>
<p style="margin: 0; color: #3A4552; font-size: 16px">Choose where you're travelling to, or select UK Visa if you're coming to or staying in the UK.</p>
<div style="display: flex; flex-wrap: wrap; gap: 10px">
<label for="visa-country" style="position: absolute; left: -9999px">Destination country</label>
<select id="visa-country" style="flex: 1 1 220px; min-width: 0; padding: 13px 14px; font-size: 16px; font-family: inherit; border: 1px solid #8FAE99; border-radius: 6px; background: #FFFFFF; color: #1B2430">
<option value="">Select a country…</option>
<option value="/uk-visa-services/">UK Visa</option>
<option value="/china-visa-application/">China</option>
<option value="/ghana-visa-services/">Ghana</option>
<option value="/indian-visa-application-uk/">India</option>
<option value="/russian-visa-services-from-uk/">Russia</option>
<option value="/saudi-arabia-visa-uk/">Saudi Arabia</option>
<option value="/schengen-visa-application/">Schengen</option>
<option value="/sri-lanka-visa-services/">Sri Lanka</option>
<option value="/usa-visa-services/">USA</option>
<option value="/worldwide-visas/">Other countries</option>
</select>
<button id="visa-check" type="button" style="background: #14532D; color: #FFFFFF; border: 0; padding: 13px 24px; border-radius: 6px; font-size: 16px; font-weight: 600; font-family: inherit; cursor: pointer">Check requirements</button>
</div>
</div>
<div style="background: #FFFFFF; border: 1px solid #DCE6DF; border-radius: 12px; padding: 28px; display: flex; flex-wrap: wrap; gap: 20px; align-items: center">
{home.iaaLogo
  ? <img src={home.iaaLogo} alt="Immigration Advice Authority logo" width="120" height="120" loading="lazy" style="flex: 0 0 120px; width: 120px; height: 120px; object-fit: contain" />
  : <div style="flex: 0 0 120px; height: 120px; background: #D6E3DA; border-radius: 8px; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 13px; color: #3A4552; padding: 8px; box-sizing: border-box">Add the IAA logo in the admin: Homepage › IAA logo</div>}
<div style="flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 8px">
<h2 style="margin: 0; font-size: 22px; color: #14532D">Regulated by the Immigration Advice Authority</h2>
<p style="margin: 0; color: #3A4552; font-size: 16px">Unique Visa Services Ltd is registered with the IAA, the UK body that regulates immigration advisers. Registration ref {site.iaaRef}.</p>
<a href="https://portal.immigrationadviceauthority.gov.uk/s/adviser-finder" style="font-weight: 600; font-size: 15px">Check our registration on the IAA register →</a>
</div>
</div>
</div>
</section>

<!-- UK routes -->
<section id="routes" style="max-width: 1200px; margin: 0 auto; padding: 88px 24px; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-direction: column; gap: 12px; max-width: 720px">
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; line-height: 1.15; font-weight: 600; color: #14532D">UK visa and immigration services</h2>
<p style="margin: 0; color: #3A4552">Whichever route applies to you, a regulated adviser reviews your application against current Home Office rules before it's submitted.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px">
<a href="/uk-spouse-visas/" style="text-decoration: none; color: inherit; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 21px; color: #14532D">Spouse &amp; Partner Visas</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Spouse, fiancé and unmarried partner visas, plus extensions. We check your financial requirement and relationship evidence.</p>
<span style="font-weight: 600; color: #14532D; font-size: 15px">View requirements →</span>
</a>
<a href="/skilled-worker-visa-formally-tier-t2-general/" style="text-decoration: none; color: inherit; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 21px; color: #14532D">Skilled Worker Visa</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">New applications, extensions and change of employment, including Certificate of Sponsorship and salary checks.</p>
<span style="font-weight: 600; color: #14532D; font-size: 15px">View requirements →</span>
</a>
<a href="/indefinite-leave-to-remain-ilr/" style="text-decoration: none; color: inherit; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 21px; color: #14532D">Indefinite Leave to Remain</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Settlement applications once you've met the qualifying period, with residence and Life in the UK checks.</p>
<span style="font-weight: 600; color: #14532D; font-size: 15px">View requirements →</span>
</a>
<a href="/british-citizenship/" style="text-decoration: none; color: inherit; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 21px; color: #14532D">British Citizenship</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Naturalisation and registration applications, including residence and good character requirements.</p>
<span style="font-weight: 600; color: #14532D; font-size: 15px">View requirements →</span>
</a>
<a href="/student-visa-uk/" style="text-decoration: none; color: inherit; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 21px; color: #14532D">UK Student Visa</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Student and child student visas and extensions, with CAS and financial evidence checks, plus the Graduate visa.</p>
<span style="font-weight: 600; color: #14532D; font-size: 15px">View requirements →</span>
</a>
<a href="/uk-visit-visa/" style="text-decoration: none; color: inherit; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 21px; color: #14532D">UK Visitor Visa</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Inviting family or business contacts to the UK? We prepare invitation letters, sponsor documents and evidence.</p>
<span style="font-weight: 600; color: #14532D; font-size: 15px">View requirements →</span>
</a>
</div>
</section>

<!-- Employers -->
<section id="employers" style="background: #14532D; color: #E7F2EA">
<div style="max-width: 1200px; margin: 0 auto; padding: 72px 24px; display: flex; flex-wrap: wrap; gap: 32px 56px; align-items: center; justify-content: space-between">
<div style="flex: 1 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 14px">
<p style="margin: 0; font-size: 14px; font-weight: 600; letter-spacing: 0.08em; color: #F2C46D">FOR EMPLOYERS</p>
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 36px; line-height: 1.2; font-weight: 600; color: #FFFFFF">Need to hire from overseas? We'll get your sponsor licence in place.</h2>
<p style="margin: 0; color: #C6DECD">Sponsor licence applications and renewals, Key Personnel set-up, compliance processes and assigning Certificates of Sponsorship, for IT, engineering, hospitality and other UK businesses.</p>
</div>
<a href="#book" style="background: #F2C46D; color: #14532D; text-decoration: none; padding: 16px 28px; border-radius: 6px; font-weight: 600">Talk to us about sponsorship</a>
</div>
</section>

<!-- Process -->
<section style="max-width: 1200px; margin: 0 auto; padding: 88px 24px; display: flex; flex-direction: column; gap: 40px">
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; line-height: 1.15; font-weight: 600; color: #14532D">How it works</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px">
<div style="display: flex; flex-direction: column; gap: 10px">
<span style="font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; color: #8A5A12; line-height: 1">1</span>
<h3 style="margin: 0; font-size: 20px; color: #14532D">Consultation</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Tell us your plans and circumstances. We confirm the right route and what it will cost.</p>
</div>
<div style="display: flex; flex-direction: column; gap: 10px">
<span style="font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; color: #8A5A12; line-height: 1">2</span>
<h3 style="margin: 0; font-size: 20px; color: #14532D">Preparation</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">We give you a document checklist and help you gather the right evidence.</p>
</div>
<div style="display: flex; flex-direction: column; gap: 10px">
<span style="font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; color: #8A5A12; line-height: 1">3</span>
<h3 style="margin: 0; font-size: 20px; color: #14532D">Review &amp; submission</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">Your adviser checks everything against current rules, then we submit.</p>
</div>
<div style="display: flex; flex-direction: column; gap: 10px">
<span style="font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; color: #8A5A12; line-height: 1">4</span>
<h3 style="margin: 0; font-size: 20px; color: #14532D">Decision</h3>
<p style="margin: 0; color: #3A4552; font-size: 16px">The Home Office makes its decision. We keep you updated and advise on next steps.</p>
</div>
</div>
</section>

<!-- Advisers / why -->
<section id="advisers" style="background: #F2F6F1">
<div style="max-width: 1200px; margin: 0 auto; padding: 88px 24px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center">
<div style="flex: 1 1 380px; min-width: 0">
{home.advisersPhoto
  ? <img src={home.advisersPhoto} alt={home.advisersPhotoAlt} width="1000" height="840" loading="lazy" style={`${photo}; height: 420px`} />
  : <div style={`${placeholder}; height: 420px`}>Add a photo in the admin: Homepage › Advisers photo</div>}
</div>
<div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 22px">
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; line-height: 1.15; font-weight: 600; color: #14532D">Meet your advisers</h2>
<p style="margin: 0; color: #3A4552">{home.advisersIntro}</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px">
<div style="display: flex; flex-direction: column; gap: 4px">
<h3 style="margin: 0; font-size: 18px; color: #14532D">Regulated advice</h3>
<p style="margin: 0; color: #3A4552; font-size: 15px">Registered with the Immigration Advice Authority. <a href="https://portal.immigrationadviceauthority.gov.uk/s/adviser-finder">Verify our registration</a></p>
</div>
<div style="display: flex; flex-direction: column; gap: 4px">
<h3 style="margin: 0; font-size: 18px; color: #14532D">One point of contact</h3>
<p style="margin: 0; color: #3A4552; font-size: 15px">The same adviser handles your case throughout.</p>
</div>
<div style="display: flex; flex-direction: column; gap: 4px">
<h3 style="margin: 0; font-size: 18px; color: #14532D">Fees agreed upfront</h3>
<p style="margin: 0; color: #3A4552; font-size: 15px">You know our fee before you commit. Consultations from {home.consultationFrom}.</p>
</div>
<div style="display: flex; flex-direction: column; gap: 4px">
<h3 style="margin: 0; font-size: 18px; color: #14532D">Checked before submission</h3>
<p style="margin: 0; color: #3A4552; font-size: 15px">Errors are caught before the Home Office sees them, not after a refusal.</p>
</div>
</div>
</div>
</div>
</section>

<!-- Reviews -->
<section style="max-width: 1200px; margin: 0 auto; padding: 88px 24px; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; align-items: flex-end">
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; line-height: 1.15; font-weight: 600; color: #14532D">What our clients say</h2>
<span style="color: #3A4552; font-size: 15px"><strong style="color: #14532D">{site.googleRating} ★</strong> from {site.googleReviewCount} Google reviews · <a href={site.googleReviewsUrl}>Read all reviews</a></span>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px">
{home.reviews.map((r) => (
<figure style="margin: 0; border: 1px solid #E3E7EC; border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 16px">
<blockquote style="margin: 0; font-size: 17px; color: #1B2430">“{r.quote}”</blockquote>
<figcaption style="font-size: 14px; color: #55606E">{r.source}</figcaption>
</figure>
))}
</div>
</section>

<!-- Worldwide -->
<section id="worldwide" style="border-top: 1px solid #E3E7EC">
<div style="max-width: 1200px; margin: 0 auto; padding: 72px 24px; display: flex; flex-direction: column; gap: 28px">
<div style="display: flex; flex-direction: column; gap: 10px; max-width: 720px">
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 32px; line-height: 1.2; font-weight: 600; color: #14532D">Travelling abroad? We handle worldwide visas too</h2>
<p style="margin: 0; color: #3A4552">Visa and eVisa applications for UK residents, plus document legalisation and Indian passport services.</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<a href="/indian-visa-application-uk/" style="text-decoration: none; border: 1px solid #C9D0D8; border-radius: 999px; padding: 10px 20px; font-weight: 500">India</a>
<a href="/china-visa-application/" style="text-decoration: none; border: 1px solid #C9D0D8; border-radius: 999px; padding: 10px 20px; font-weight: 500">China</a>
<a href="/schengen-visa-application/" style="text-decoration: none; border: 1px solid #C9D0D8; border-radius: 999px; padding: 10px 20px; font-weight: 500">Schengen</a>
<a href="/usa-visa-services/" style="text-decoration: none; border: 1px solid #C9D0D8; border-radius: 999px; padding: 10px 20px; font-weight: 500">USA</a>
<a href="/saudi-arabia-visa-uk/" style="text-decoration: none; border: 1px solid #C9D0D8; border-radius: 999px; padding: 10px 20px; font-weight: 500">Saudi Arabia</a>
<a href="/ghana-visa-services/" style="text-decoration: none; border: 1px solid #C9D0D8; border-radius: 999px; padding: 10px 20px; font-weight: 500">Ghana</a>
<a href="/russian-visa-services-from-uk/" style="text-decoration: none; border: 1px solid #C9D0D8; border-radius: 999px; padding: 10px 20px; font-weight: 500">Russia</a>
<a href="/sri-lanka-visa-services/" style="text-decoration: none; border: 1px solid #C9D0D8; border-radius: 999px; padding: 10px 20px; font-weight: 500">Sri Lanka</a>
<a href="/document-legalisation/" style="text-decoration: none; border: 1px solid #C9D0D8; border-radius: 999px; padding: 10px 20px; font-weight: 500">Document legalisation</a>
<a href="/worldwide-visas/" style="text-decoration: none; border: 1px solid #C9D0D8; border-radius: 999px; padding: 10px 20px; font-weight: 500">All countries →</a>
</div>
</div>
</section>

<!-- FAQ -->
<section style="background: #F2F6F1">
<div style="max-width: 880px; margin: 0 auto; padding: 88px 24px; display: flex; flex-direction: column; gap: 28px">
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 40px; line-height: 1.15; font-weight: 600; color: #14532D">Common questions</h2>
<div style="display: flex; flex-direction: column">
{home.faqs.map((f, i) => (
<details open={i === 0} style="border-bottom: 1px solid #D5D9DE; padding: 20px 0">
<summary style="font-weight: 600; font-size: 18px; color: #14532D">{f.q}</summary>
<p style="margin: 12px 0 0; color: #3A4552">{f.a}</p>
</details>
))}
</div>
</div>
</section>

<!-- Final CTA -->
<section id="book" style="max-width: 1200px; margin: 0 auto; padding: 88px 24px">
<div style="background: #14532D; border-radius: 14px; padding: 56px 48px; display: flex; flex-wrap: wrap; gap: 28px; justify-content: space-between; align-items: center">
<div style="flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 10px">
<h2 style="margin: 0; font-family: 'Source Serif 4', Georgia, serif; font-size: 36px; line-height: 1.2; font-weight: 600; color: #FFFFFF">Not sure which visa you need?</h2>
<p style="margin: 0; color: #C6DECD">Book a consultation and we'll tell you your options, what you'll need and what it will cost.</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 14px">
<a href={site.bookingUrl} style="background: #F2C46D; color: #14532D; text-decoration: none; padding: 16px 28px; border-radius: 6px; font-weight: 600">Book a consultation</a>
<a href={tel} style="color: #FFFFFF; text-decoration: none; padding: 15px 27px; border-radius: 6px; font-weight: 600; border: 1px solid #FFFFFF">{site.phone}</a>
</div>
</div>
</section>
</main>
</Page>

<script>
  // Worldwide visa picker: go to the chosen country page
  document.getElementById('visa-check')?.addEventListener('click', () => {
    const url = (document.getElementById('visa-country') as HTMLSelectElement).value;
    if (url) window.location.href = url;
  });
</script>
