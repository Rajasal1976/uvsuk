    { "label": "Are you married?", "type": "Yes / No", "required": true },
    { "label": "How does your partner meet the financial requirement?", "type": "Choice list", "options": "Employment\nSelf-employment\nSavings\nPension\nNot sure", "required": true },
    { "label": "Anything else we should know?", "type": "Long answer", "required": false }
  ],
  "uploads": [
    { "label": "Marriage certificate", "required": true },
    { "label": "Partner's last 6 months of payslips", "required": true, "hint": "A single PDF is best." },
    { "label": "English language test certificate", "required": false }
  ]
}
