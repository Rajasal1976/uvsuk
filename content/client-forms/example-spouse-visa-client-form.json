{
  "title": "Example: spouse visa client form",
  "active": true,
  "password": "Demo-1234-Form",
  "intro": "Please answer these questions and upload your documents. Your adviser will review everything and contact you.",
  "includePassport": true,
  "maxPeople": 2,
  "questionsTitle": "Your relationship and finances",
  "askOnce": false,
  "questions": [
    { "label": "When did you and your partner first meet?", "type": "Date", "required": true },
