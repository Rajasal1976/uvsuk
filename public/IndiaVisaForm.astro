---
// India e-Visa application form
// Sent with Netlify Forms, including file uploads. See the setup notes in the chat.
---
<section class="vf" id="india-evisa-form">
  <h1 class="vf-title">India e-Visa application</h1>
  <p class="vf-lede">Most of your details come straight from your passport, so this only takes a few minutes. Have your passport ready.</p>
  <div class="vf-progress"><p class="vf-progress-label" aria-live="polite"></p><div class="vf-bar"><span></span></div></div>
  <form name="india-evisa" method="POST" enctype="multipart/form-data" data-netlify="true" netlify-honeypot="bot-field" data-vf novalidate>
    <input type="hidden" name="form-name" value="india-evisa">
    <p hidden><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
    <div class="vf-step" data-title="Before you start" data-stop-if="pakistan_origin=Yes"><h2 tabindex="-1">Before you start</h2><fieldset class="vf-field"><legend>Were you, or any of your parents or grandparents, born in Pakistan or ever a Pakistani national?</legend><div class="vf-choices"><label class="vf-choice"><input type="radio" name="pakistan_origin" value="Yes" required><span>Yes</span></label><label class="vf-choice"><input type="radio" name="pakistan_origin" value="No" required><span>No</span></label></div></fieldset><div class="vf-stop" data-show-if="pakistan_origin=Yes" role="alert"><h3>You can’t apply for an Indian e-Visa</h3><p>Indian rules don’t allow an e-Visa for anyone whose parents or grandparents were born in, lived permanently in, or were nationals of Pakistan. This applies even if you hold a British passport.</p><p>You’ll need a regular (paper) visa instead. Call us on <a href="tel:01619562003">0161 956 2003</a> and we’ll explain what you need.</p></div></div><div class="vf-step" data-title="Passport and photo"><h2 tabindex="-1">Passport and photo</h2><p class=vf-intro>Upload your passport’s photo page and a photo of you. We’ll copy your name, date and place of birth and passport details from your passport.</p><div class="vf-field vf-file"><label class="vf-label" for="india-evisa-form-passport_page">Passport photo page</label><span class="vf-hint" id="india-evisa-form-h-passport_page">The page with your photo. Make sure all four corners and the two lines of code at the bottom are clear.</span><div class="vf-filewrap"><input type="file" class="vf-fileinput" id="india-evisa-form-passport_page" name="passport_page" accept="image/*,.pdf" required><div class="vf-filebox" aria-hidden="true"><span class="vf-filebtn">Choose file or take photo</span><span class="vf-filename">No file chosen</span></div></div></div><div class="vf-field vf-file"><label class="vf-label" for="india-evisa-form-photo">Passport-style photo of you</label><span class="vf-hint" id="india-evisa-form-h-photo">Plain white background, face straight on, no glasses or hat.</span><div class="vf-filewrap"><input type="file" class="vf-fileinput" id="india-evisa-form-photo" name="photo" accept="image/*,.pdf" required><div class="vf-filebox" aria-hidden="true"><span class="vf-filebtn">Choose file or take photo</span><span class="vf-filename">No file chosen</span></div></div></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-full_name">Full name, as shown in your passport</label><input type="text" id="india-evisa-form-full_name" name="full_name" autocomplete="name" required></div><fieldset class="vf-field"><legend>How did you get your current nationality?</legend><div class="vf-choices"><label class="vf-choice"><input type="radio" name="nationality_by" value="By birth" required><span>By birth</span></label><label class="vf-choice"><input type="radio" name="nationality_by" value="By naturalisation" required><span>By naturalisation</span></label></div></fieldset><div class="vf-cond" data-show-if="nationality_by=By naturalisation"><div class="vf-field"><label class="vf-label" for="india-evisa-form-previous_nationality">Your previous nationality</label><input type="text" id="india-evisa-form-previous_nationality" name="previous_nationality" required></div></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-religion">Religion</label><select id="india-evisa-form-religion" name="religion" required><option value="">Choose…</option><option>Bahai</option><option>Buddhism</option><option>Christian</option><option>Hindu</option><option>Islam</option><option>Judaism</option><option>Parsi</option><option>Sikh</option><option>Zoroastrian</option><option>Other</option></select></div><div class="vf-cond" data-show-if="religion=Other"><div class="vf-field"><label class="vf-label" for="india-evisa-form-religion_other">Your religion</label><input type="text" id="india-evisa-form-religion_other" name="religion_other" required></div></div></div><div class="vf-step" data-title="Contact details"><h2 tabindex="-1">Contact details</h2><p class=vf-intro>We’ll use these to send you updates about your application.</p><div class="vf-field"><label class="vf-label" for="india-evisa-form-email">Email address</label><input type="email" id="india-evisa-form-email" name="email" autocomplete="email" required></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-phone">Mobile number</label><input type="tel" id="india-evisa-form-phone" name="phone" autocomplete="tel" required></div><h3 class="vf-sub">Home address</h3><div class="vf-field"><label class="vf-label" for="india-evisa-form-address_1">Address line 1</label><input type="text" id="india-evisa-form-address_1" name="address_1" autocomplete="address-line1" required></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-address_2">Address line 2 <span class="vf-opt">(optional)</span></label><input type="text" id="india-evisa-form-address_2" name="address_2" autocomplete="address-line2"></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-town">Town or city</label><input type="text" id="india-evisa-form-town" name="town" autocomplete="address-level2" required></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-postcode">Postcode</label><input type="text" id="india-evisa-form-postcode" name="postcode" autocomplete="postal-code" required></div></div><div class="vf-step" data-title="Family"><h2 tabindex="-1">Family</h2><h3 class="vf-sub vf-sub-first">Father</h3><div class="vf-field"><label class="vf-label" for="india-evisa-form-father_name">Full name</label><input type="text" id="india-evisa-form-father_name" name="father_name" required></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-father_nationality">Nationality</label><input type="text" id="india-evisa-form-father_nationality" name="father_nationality" required></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-father_birth_place">Place of birth</label><span class="vf-hint" id="india-evisa-form-h-father_birth_place">Town or city, and country</span><input type="text" id="india-evisa-form-father_birth_place" name="father_birth_place" aria-describedby="india-evisa-form-h-father_birth_place" required></div><h3 class="vf-sub">Mother</h3><div class="vf-field"><label class="vf-label" for="india-evisa-form-mother_name">Full name</label><input type="text" id="india-evisa-form-mother_name" name="mother_name" required></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-mother_nationality">Nationality</label><input type="text" id="india-evisa-form-mother_nationality" name="mother_nationality" required></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-mother_birth_place">Place of birth</label><span class="vf-hint" id="india-evisa-form-h-mother_birth_place">Town or city, and country</span><input type="text" id="india-evisa-form-mother_birth_place" name="mother_birth_place" aria-describedby="india-evisa-form-h-mother_birth_place" required></div><h3 class="vf-sub">Marital status</h3><div class="vf-field"><label class="vf-label" for="india-evisa-form-marital_status">Your marital status</label><select id="india-evisa-form-marital_status" name="marital_status" required><option value="">Choose…</option><option>Single</option><option>Married</option><option>Divorced</option><option>Widowed</option></select></div><div class="vf-cond" data-show-if="marital_status=Married"><div class="vf-field"><label class="vf-label" for="india-evisa-form-spouse_name">Husband or wife’s full name</label><input type="text" id="india-evisa-form-spouse_name" name="spouse_name" required></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-spouse_nationality">Their nationality</label><input type="text" id="india-evisa-form-spouse_nationality" name="spouse_nationality" required></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-spouse_birth_place">Their place of birth</label><span class="vf-hint" id="india-evisa-form-h-spouse_birth_place">Town or city, and country</span><input type="text" id="india-evisa-form-spouse_birth_place" name="spouse_birth_place" aria-describedby="india-evisa-form-h-spouse_birth_place" required></div></div></div><div class="vf-step" data-title="Work"><h2 tabindex="-1">Work</h2><div class="vf-field"><label class="vf-label" for="india-evisa-form-occupation">Your occupation</label><select id="india-evisa-form-occupation" name="occupation" required><option value="">Choose…</option><option>Employed</option><option>Self-employed</option><option>Student</option><option>Retired</option><option>Homemaker</option><option>Not working</option></select></div><div class="vf-cond" data-show-if="occupation=Employed|Self-employed"><div class="vf-field"><label class="vf-label" for="india-evisa-form-job_title">Job title</label><input type="text" id="india-evisa-form-job_title" name="job_title" required></div></div><div class="vf-cond" data-show-if="occupation=Employed|Self-employed|Student"><div class="vf-field"><label class="vf-label" for="india-evisa-form-employer_name">Employer, business or school name</label><input type="text" id="india-evisa-form-employer_name" name="employer_name" required></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-employer_address">Its address</label><textarea id="india-evisa-form-employer_address" name="employer_address" rows="3" required></textarea></div></div></div><div class="vf-step" data-title="Your trip"><h2 tabindex="-1">Your trip</h2><div class="vf-field"><label class="vf-label" for="india-evisa-form-visa_type">Which visa do you need?</label><select id="india-evisa-form-visa_type" name="visa_type" required><option value="">Choose…</option><option>e-Tourist visa (30 days)</option><option>e-Tourist visa (1 year)</option><option>e-Tourist visa (5 years)</option><option>e-Business visa</option><option>e-Medical visa</option><option>e-Medical Attendant visa</option><option>Not sure, please advise</option></select></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-arrival_date">Date you arrive in India</label><input type="date" id="india-evisa-form-arrival_date" name="arrival_date" required data-future></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-arrival_airport">Airport you’ll arrive at</label><span class="vf-hint" id="india-evisa-form-h-arrival_airport">Start typing, for example Delhi or Mumbai</span><input type="text" id="india-evisa-form-arrival_airport" name="arrival_airport" aria-describedby="india-evisa-form-h-arrival_airport" required list="india-evisa-form-airports"></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-exit_airport">Airport you’ll leave from</label><input type="text" id="india-evisa-form-exit_airport" name="exit_airport" required list="india-evisa-form-airports"></div><datalist id="india-evisa-form-airports"><option value="Ahmedabad"><option value="Amritsar"><option value="Bengaluru"><option value="Chennai"><option value="Delhi"><option value="Goa (Dabolim)"><option value="Goa (Mopa)"><option value="Hyderabad"><option value="Jaipur"><option value="Kochi"><option value="Kolkata"><option value="Kozhikode"><option value="Lucknow"><option value="Mumbai"><option value="Pune"><option value="Thiruvananthapuram"><option value="Varanasi"></datalist><fieldset class="vf-field"><legend>Have you been to India before?</legend><div class="vf-choices"><label class="vf-choice"><input type="radio" name="india_before" value="Yes" required><span>Yes</span></label><label class="vf-choice"><input type="radio" name="india_before" value="No" required><span>No</span></label></div></fieldset><div class="vf-cond" data-show-if="india_before=Yes"><div class="vf-field"><label class="vf-label" for="india-evisa-form-india_before_details">Where did you stay, and which cities did you visit?</label><textarea id="india-evisa-form-india_before_details" name="india_before_details" rows="3" required></textarea></div><div class="vf-note"><p>If you still have your last Indian visa, upload it so we can copy the visa number. If not, you can still continue.</p></div><div class="vf-field vf-file"><label class="vf-label" for="india-evisa-form-previous_india_visa">Your last Indian visa <span class="vf-opt">(optional)</span></label><div class="vf-filewrap"><input type="file" class="vf-fileinput" id="india-evisa-form-previous_india_visa" name="previous_india_visa" accept="image/*,.pdf"><div class="vf-filebox" aria-hidden="true"><span class="vf-filebtn">Choose file or take photo</span><span class="vf-filename">No file chosen</span></div></div></div></div><h3 class="vf-sub">Reference in India</h3><div class="vf-note"><p>Someone in India we can list on your application. If you don’t know anyone there, use your hotel.</p></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-ref_india_name">Name</label><input type="text" id="india-evisa-form-ref_india_name" name="ref_india_name" required></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-ref_india_address">Address</label><textarea id="india-evisa-form-ref_india_address" name="ref_india_address" rows="3" required></textarea></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-ref_india_phone">Phone number</label><input type="tel" id="india-evisa-form-ref_india_phone" name="ref_india_phone" required></div><h3 class="vf-sub">Reference in the UK</h3><div class="vf-field"><label class="vf-label" for="india-evisa-form-ref_uk_name">Name</label><span class="vf-hint" id="india-evisa-form-h-ref_uk_name">A friend, relative or colleague who doesn’t live with you</span><input type="text" id="india-evisa-form-ref_uk_name" name="ref_uk_name" aria-describedby="india-evisa-form-h-ref_uk_name" required></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-ref_uk_address">Address</label><textarea id="india-evisa-form-ref_uk_address" name="ref_uk_address" rows="3" required></textarea></div><div class="vf-field"><label class="vf-label" for="india-evisa-form-ref_uk_phone">Phone number</label><input type="tel" id="india-evisa-form-ref_uk_phone" name="ref_uk_phone" required></div></div><div class="vf-step" data-title="Background questions"><h2 tabindex="-1">Background questions</h2><p class=vf-intro>Answer each question. If you answer yes, tell us briefly what happened. A yes doesn’t always lead to a refusal, but leaving something out can.</p><fieldset class="vf-yesno"><legend>Have you ever been arrested, prosecuted or convicted by a court in any country?</legend><div class="vf-choices"><label class="vf-choice"><input type="radio" name="arrested" value="Yes" required><span>Yes</span></label><label class="vf-choice"><input type="radio" name="arrested" value="No" required><span>No</span></label></div><div class="vf-cond" data-show-if="arrested=Yes"><div class="vf-field"><label class="vf-label" for="india-evisa-form-arrested_details">Tell us what happened, with dates</label><textarea id="india-evisa-form-arrested_details" name="arrested_details" rows="3" required></textarea></div></div></fieldset><fieldset class="vf-yesno"><legend>Have you ever been refused entry to, or deported from, any country, including India?</legend><div class="vf-choices"><label class="vf-choice"><input type="radio" name="refused_deported" value="Yes" required><span>Yes</span></label><label class="vf-choice"><input type="radio" name="refused_deported" value="No" required><span>No</span></label></div><div class="vf-cond" data-show-if="refused_deported=Yes"><div class="vf-field"><label class="vf-label" for="india-evisa-form-refused_deported_details">Tell us what happened, with dates</label><textarea id="india-evisa-form-refused_deported_details" name="refused_deported_details" rows="3" required></textarea></div></div></fieldset><fieldset class="vf-yesno"><legend>Have you ever been involved in human trafficking, drug trafficking, child abuse, crimes against women, economic offences or financial fraud?</legend><div class="vf-choices"><label class="vf-choice"><input type="radio" name="trafficking" value="Yes" required><span>Yes</span></label><label class="vf-choice"><input type="radio" name="trafficking" value="No" required><span>No</span></label></div><div class="vf-cond" data-show-if="trafficking=Yes"><div class="vf-field"><label class="vf-label" for="india-evisa-form-trafficking_details">Tell us what happened, with dates</label><textarea id="india-evisa-form-trafficking_details" name="trafficking_details" rows="3" required></textarea></div></div></fieldset><fieldset class="vf-yesno"><legend>Have you ever been involved in cyber crime, terrorism, sabotage, espionage, genocide, political killing or any other act of violence?</legend><div class="vf-choices"><label class="vf-choice"><input type="radio" name="terrorism" value="Yes" required><span>Yes</span></label><label class="vf-choice"><input type="radio" name="terrorism" value="No" required><span>No</span></label></div><div class="vf-cond" data-show-if="terrorism=Yes"><div class="vf-field"><label class="vf-label" for="india-evisa-form-terrorism_details">Tell us what happened, with dates</label><textarea id="india-evisa-form-terrorism_details" name="terrorism_details" rows="3" required></textarea></div></div></fieldset><fieldset class="vf-yesno"><legend>Have you ever expressed views, in any way, that justify or glorify terrorist violence or could encourage others to commit terrorist acts?</legend><div class="vf-choices"><label class="vf-choice"><input type="radio" name="views" value="Yes" required><span>Yes</span></label><label class="vf-choice"><input type="radio" name="views" value="No" required><span>No</span></label></div><div class="vf-cond" data-show-if="views=Yes"><div class="vf-field"><label class="vf-label" for="india-evisa-form-views_details">Tell us what happened, with dates</label><textarea id="india-evisa-form-views_details" name="views_details" rows="3" required></textarea></div></div></fieldset><fieldset class="vf-yesno"><legend>Have you ever applied for asylum in any country?</legend><div class="vf-choices"><label class="vf-choice"><input type="radio" name="asylum" value="Yes" required><span>Yes</span></label><label class="vf-choice"><input type="radio" name="asylum" value="No" required><span>No</span></label></div><div class="vf-cond" data-show-if="asylum=Yes"><div class="vf-field"><label class="vf-label" for="india-evisa-form-asylum_details">Tell us what happened, with dates</label><textarea id="india-evisa-form-asylum_details" name="asylum_details" rows="3" required></textarea></div></div></fieldset><fieldset class="vf-yesno"><legend>In the last 3 years, have you visited any South Asian (SAARC) country other than your own? These are Afghanistan, Bangladesh, Bhutan, Maldives, Nepal, Pakistan and Sri Lanka.</legend><div class="vf-choices"><label class="vf-choice"><input type="radio" name="saarc" value="Yes" required><span>Yes</span></label><label class="vf-choice"><input type="radio" name="saarc" value="No" required><span>No</span></label></div><div class="vf-cond" data-show-if="saarc=Yes"><div class="vf-field"><label class="vf-label" for="india-evisa-form-saarc_details">Which countries, which years, and how many visits</label><textarea id="india-evisa-form-saarc_details" name="saarc_details" rows="3" required></textarea></div></div></fieldset><div class="vf-check"><label><input type="checkbox" name="declaration" value="Yes" required><span>I confirm the information I’ve given is true and complete, and I agree to Unique Visa Services using it to prepare my application.</span></label></div></div>
    <p class="vf-send-error" role="alert" hidden></p>
    <div class="vf-nav">
      <button type="button" class="vf-btn vf-btn-back" data-vf-back>Back</button>
      <button type="button" class="vf-btn vf-btn-main" data-vf-next>Continue</button>
      <button type="submit" class="vf-btn vf-btn-main" data-vf-submit>Send my application</button>
    </div>
  </form>
  <div class="vf-done" hidden role="status"><h2 tabindex="-1">Application sent</h2><p>Thank you. We’ve received your details and documents, and we’ll be in touch once we’ve checked everything.</p><p>Need us sooner? Call <a href="tel:01619562003">0161 956 2003</a>, Monday to Friday, 9am to 5pm.</p></div>
</section>

<style is:global>
.vf{--vf-green:#2B5434;--vf-gold:#8A6A2B;--vf-ink:#1E2A22;--vf-muted:#56625A;--vf-line:#C6CDC3;--vf-bg:#FFFFFF;--vf-tint:#F1F3EC;--vf-error:#B42318;--vf-error-bg:#FEF3F2;--vf-serif:Georgia,"Times New Roman",serif;
  color:var(--vf-ink);max-width:640px;margin:0 auto;font-size:1.0625rem;line-height:1.55;scroll-margin-top:1rem}
.vf [hidden]{display:none!important}
.vf-title{font-family:var(--vf-serif);color:var(--vf-green);font-size:clamp(1.75rem,5vw,2.25rem);line-height:1.15;font-weight:600;margin:0 0 .5rem}
.vf-lede{color:var(--vf-muted);margin:0}
.vf-progress{margin:1.5rem 0 2rem}
.vf-progress-label{font-size:.9375rem;color:var(--vf-muted);margin:0 0 .5rem}
.vf-progress-label strong{color:var(--vf-ink);font-weight:600}
.vf-bar{height:6px;background:var(--vf-line);border-radius:3px;overflow:hidden}
.vf-bar span{display:block;height:100%;width:0;background:var(--vf-gold);transition:width .3s ease}
.vf-step h2,.vf-done h2{font-family:var(--vf-serif);color:var(--vf-green);font-size:1.5rem;line-height:1.2;font-weight:600;margin:0 0 .5rem}
.vf-step h2:focus{outline:none}
.vf-intro{color:var(--vf-muted);margin:0 0 1.75rem}
.vf-sub-first{border-top:0!important;padding-top:0!important;margin-top:1rem!important}
.vf-sub{font-size:1.125rem;font-weight:600;margin:2rem 0 1rem;padding-top:1.5rem;border-top:1px solid var(--vf-line)}
.vf-field{margin:0 0 1.375rem;border:0;padding:0;min-width:0}
.vf-label,.vf-field legend{display:block;font-weight:600;margin:0 0 .375rem;padding:0}
.vf-opt{font-weight:400;color:var(--vf-muted)}
.vf-hint{display:block;color:var(--vf-muted);font-size:.9375rem;margin:-.125rem 0 .5rem}
.vf input[type=text],.vf input[type=email],.vf input[type=tel],.vf input[type=date],.vf select,.vf textarea{display:block;width:100%;box-sizing:border-box;font:inherit;font-size:max(16px,1rem);padding:.7rem .8rem;min-height:50px;border:1.5px solid var(--vf-line);border-radius:6px;background:var(--vf-bg);color:var(--vf-ink)}
.vf textarea{min-height:6.5rem;resize:vertical}
.vf input:focus-visible,.vf select:focus-visible,.vf textarea:focus-visible{outline:3px solid var(--vf-gold);outline-offset:1px;border-color:var(--vf-green)}
.vf [aria-invalid=true]{border-color:var(--vf-error)!important}
.vf-choices{display:flex;flex-wrap:wrap;gap:.5rem}
.vf-choice{position:relative;display:inline-flex}
.vf-choice input{position:absolute;opacity:0;width:1px;height:1px;margin:0;pointer-events:none}
.vf-choice span{display:inline-flex;align-items:center;min-height:50px;min-width:5rem;justify-content:center;padding:0 1.25rem;border:1.5px solid var(--vf-line);border-radius:6px;background:var(--vf-bg);cursor:pointer;font-weight:500}
.vf-choice input:checked+span{background:var(--vf-green);border-color:var(--vf-green);color:#fff}
.vf-choice input:focus-visible+span{outline:3px solid var(--vf-gold);outline-offset:2px}
.vf-file{position:relative}
.vf-filebox{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem 1rem;padding:1rem;border:1.5px dashed var(--vf-line);border-radius:6px;background:var(--vf-tint);cursor:pointer}
.vf-filebtn{display:inline-flex;align-items:center;min-height:44px;padding:0 1rem;border-radius:6px;background:var(--vf-bg);border:1.5px solid var(--vf-green);color:var(--vf-green);font-weight:600}
.vf-filename{color:var(--vf-muted);font-size:.9375rem;word-break:break-all}
.vf-file.has-file .vf-filebox{border-style:solid;border-color:var(--vf-green)}
.vf-file.has-file .vf-filename{color:var(--vf-ink)}
.vf-fileinput:focus-visible~.vf-filebox{outline:3px solid var(--vf-gold);outline-offset:2px}
.vf-file:has(.vf-error) .vf-filebox{border-color:var(--vf-error)}
.vf-note{background:var(--vf-tint);border-left:4px solid var(--vf-gold);padding:.875rem 1rem;margin:0 0 1.375rem;border-radius:0 6px 6px 0}
.vf-note p{margin:0}
.vf-stop{border:1.5px solid var(--vf-error);background:var(--vf-error-bg);color:var(--vf-ink);padding:1.125rem 1.25rem;border-radius:6px;margin:0 0 1.375rem}
.vf-stop h3{margin:0 0 .5rem;font-size:1.125rem;color:var(--vf-error)}
.vf-stop p{margin:0 0 .5rem}.vf-stop p:last-child{margin:0}
.vf-stop a,.vf-done a{color:var(--vf-green);font-weight:600}
.vf-yesno{padding:1rem 0;margin:0;border-bottom:1px solid var(--vf-line)}
.vf-yesno legend{font-weight:500;margin-bottom:.625rem}
.vf-yesno .vf-cond{margin-top:.875rem}
.vf-yesno .vf-cond .vf-field{margin-bottom:0}
.vf-check label{display:flex;gap:.75rem;align-items:flex-start;cursor:pointer;font-weight:500}
.vf-check input{width:24px;height:24px;flex:none;margin:.1rem 0 0;accent-color:var(--vf-green)}
.vf-error{color:var(--vf-error);font-size:.9375rem;font-weight:600;margin:.4rem 0 0}
.vf-nav{display:flex;gap:.75rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--vf-line)}
.vf-nav [data-vf-next],.vf-nav [data-vf-submit]{margin-left:auto}
.vf-btn{font:inherit;font-weight:600;min-height:52px;padding:0 1.5rem;border-radius:6px;cursor:pointer;border:1.5px solid var(--vf-green)}
.vf-btn-main{background:var(--vf-green);color:#fff}
.vf-btn-back{background:transparent;color:var(--vf-green)}
.vf-btn:focus-visible{outline:3px solid var(--vf-gold);outline-offset:2px}
.vf-btn:disabled{opacity:.6;cursor:progress}
.vf-done{padding:1rem 0}
.vf-done h2:focus{outline:none}
@media (prefers-reduced-motion:reduce){.vf-bar span{transition:none}}
.vf-send-error{color:var(--vf-error);background:var(--vf-error-bg);border:1.5px solid var(--vf-error);border-radius:6px;padding:.75rem 1rem;font-weight:600;margin:1.25rem 0 0}
.vf-filewrap{position:relative}
.vf-fileinput{position:absolute;inset:0;width:100%;height:100%;opacity:0;margin:0;padding:0;cursor:pointer;z-index:2;font-size:16px}
</style>

<script is:inline>
(function(){
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  var LIMIT = 7.5 * 1024 * 1024; // Netlify Forms allows about 8 MB per submission
  document.querySelectorAll('form[data-vf]').forEach(function(form){
    if (form.dataset.vfReady) return; form.dataset.vfReady = '1';
    var wrap = form.closest('.vf');
    var steps = Array.prototype.slice.call(form.querySelectorAll('.vf-step'));
    var last = steps.length - 1, i = 0;
    var label = wrap.querySelector('.vf-progress-label');
    var bar = wrap.querySelector('.vf-bar span');
    var back = form.querySelector('[data-vf-back]');
    var next = form.querySelector('[data-vf-next]');
    var submit = form.querySelector('[data-vf-submit]');
    var sendErr = form.querySelector('.vf-send-error');
    var conds = Array.prototype.slice.call(form.querySelectorAll('[data-show-if]'));
    var today = new Date().toISOString().slice(0,10);
    form.querySelectorAll('[data-future]').forEach(function(d){ d.min = today; });
    form.querySelectorAll('[data-past]').forEach(function(d){ d.max = today; });

    function val(name){ var el = form.elements[name]; return el ? el.value : ''; }
    function matches(rule){ var p = rule.split('='); return p[1].split('|').indexOf(val(p[0])) > -1; }
    function update(){
      conds.forEach(function(el){
        var on = matches(el.dataset.showIf);
        el.hidden = !on;
        el.querySelectorAll('input,select,textarea').forEach(function(f){ f.disabled = !on; });
      });
      var s = steps[i];
      var stop = s.dataset.stopIf && matches(s.dataset.stopIf);
      back.hidden = i === 0;
      next.hidden = i === last || !!stop;
      submit.hidden = i !== last;
      label.innerHTML = 'Step ' + (i+1) + ' of ' + steps.length + ': <strong>' + s.dataset.title + '</strong>';
      bar.style.width = ((i+1) / steps.length * 100) + '%';
    }
    function clearErr(scope){
      scope.querySelectorAll('.vf-error').forEach(function(e){ e.remove(); });
      scope.querySelectorAll('[aria-invalid]').forEach(function(e){ e.removeAttribute('aria-invalid'); });
    }
    function addErr(f, msg){
      var box = f.type === 'radio' ? f.closest('fieldset') : (f.closest('.vf-check') || f.closest('.vf-field'));
      if (box.querySelector(':scope > .vf-error')) return;
      var p = document.createElement('p'); p.className = 'vf-error'; p.textContent = msg;
      box.appendChild(p); f.setAttribute('aria-invalid','true');
    }
    function message(f){
      if (f.type === 'radio') return 'Choose an answer to continue.';
      if (f.type === 'file') return 'Upload this document to continue.';
      if (f.type === 'checkbox') return 'Tick this box to send your application.';
      if (f.validity.typeMismatch && f.type === 'email') return 'Enter an email address like name@example.com.';
      if (f.validity.rangeUnderflow) return 'Choose a date in the future.';
      if (f.validity.rangeOverflow) return 'Choose a date in the past.';
      return 'Fill this in to continue.';
    }
    function validStep(){
      var s = steps[i]; clearErr(s);
      var bad = null, seen = {};
      s.querySelectorAll('input,select,textarea').forEach(function(f){
        if (f.disabled) return;
        if (f.type === 'radio'){ if (seen[f.name]) return; seen[f.name] = 1; }
        if (!f.checkValidity()){ addErr(f, message(f)); bad = bad || f; }
      });
      if (bad){ bad.focus(); if (bad.scrollIntoView) bad.closest('.vf-field,fieldset,.vf-check').scrollIntoView({block:'center', behavior: reduce ? 'auto' : 'smooth'}); }
      return !bad;
    }
    function go(n){
      steps[i].hidden = true; i = n; steps[i].hidden = false; update();
      wrap.scrollIntoView({block:'start', behavior: reduce ? 'auto' : 'smooth'});
      var h = steps[i].querySelector('h2'); if (h) h.focus({preventScroll:true});
    }
    function goNext(){
      var s = steps[i];
      if (s.dataset.stopIf && matches(s.dataset.stopIf)) return;
      if (validStep()) go(i+1);
    }
    back.addEventListener('click', function(){ go(i-1); });
    next.addEventListener('click', goNext);
    form.addEventListener('change', function(e){
      update();
      var box = e.target.closest('fieldset,.vf-field,.vf-check'); if (box) clearErr(box);
    });
    form.addEventListener('input', function(e){
      var box = e.target.closest('.vf-field'); if (box && e.target.type !== 'file') clearErr(box);
    });

    // Shrink phone photos so uploads stay under the size limit
    function shrink(file){
      if (!/^image\/(jpeg|png|webp)$/.test(file.type) || file.size < 700*1024) return Promise.resolve(file);
      return new Promise(function(resolve){
        var url = URL.createObjectURL(file), img = new Image();
        img.onload = function(){
          var max = 2000, s = Math.min(1, max / Math.max(img.naturalWidth, img.naturalHeight));
          var c = document.createElement('canvas');
          c.width = Math.round(img.naturalWidth * s); c.height = Math.round(img.naturalHeight * s);
          var ctx = c.getContext('2d'); ctx.fillStyle = '#fff'; ctx.fillRect(0,0,c.width,c.height);
          ctx.drawImage(img, 0, 0, c.width, c.height); URL.revokeObjectURL(url);
          c.toBlob(function(b){
            if (!b || b.size >= file.size) return resolve(file);
            resolve(new File([b], file.name.replace(/\.[^.]+$/,'') + '.jpg', {type:'image/jpeg'}));
          }, 'image/jpeg', 0.85);
        };
        img.onerror = function(){ URL.revokeObjectURL(url); resolve(file); };
        img.src = url;
      });
    }
    function size(b){ return b > 1048576 ? (b/1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b/1024)) + ' KB'; }
    form.querySelectorAll('.vf-fileinput').forEach(function(inp){
      var box = inp.closest('.vf-file'), name = box.querySelector('.vf-filename');
      inp.addEventListener('change', function(){
        clearErr(box);
        var f = inp.files && inp.files[0];
        if (!f){ box.classList.remove('has-file'); name.textContent = 'No file chosen'; return; }
        name.textContent = 'Preparing ' + f.name + '…';
        shrink(f).then(function(out){
          if (out !== f){ try { var dt = new DataTransfer(); dt.items.add(out); inp.files = dt.files; } catch(e){ out = f; } }
          box.classList.add('has-file');
          name.textContent = out.name + ' (' + size(out.size) + ')';
        });
      });
    });

    form.addEventListener('submit', function(e){
      e.preventDefault();
      if (i < last){ goNext(); return; }
      if (!validStep()) return;
      var total = 0;
      form.querySelectorAll('.vf-fileinput').forEach(function(inp){ if (!inp.disabled && inp.files[0]) total += inp.files[0].size; });
      sendErr.hidden = true;
      if (total > LIMIT){
        sendErr.textContent = 'Your documents add up to ' + size(total) + ', which is too large to send. The limit is 8 MB. Upload photos of the pages instead of large PDF scans, or email the extra documents to us after sending this form.';
        sendErr.hidden = false; return;
      }
      var txt = submit.textContent; submit.disabled = true; submit.textContent = 'Sending…';
      var send = window.VF_PREVIEW
        ? new Promise(function(r){ setTimeout(r, 700); })
        : fetch('/', { method:'POST', body:new FormData(form) }).then(function(r){ if (!r.ok) throw new Error(r.status); });
      send.then(function(){
        form.hidden = true; wrap.querySelector('.vf-progress').hidden = true;
        var done = wrap.querySelector('.vf-done'); done.hidden = false;
        wrap.scrollIntoView({block:'start', behavior: reduce ? 'auto' : 'smooth'});
        done.querySelector('h2').focus({preventScroll:true});
      }).catch(function(){
        sendErr.textContent = 'Your application wasn’t sent. Check your internet connection and try again, or call us on 0161 956 2003.';
        sendErr.hidden = false; submit.disabled = false; submit.textContent = txt;
      });
    });
    steps.forEach(function(s, n){ s.hidden = n !== 0; });
    update();
  });
})();
</script>
